@inherits PanelComponent
@namespace GeneralGame.HUD

@if(IsProxy)
return;

<root>
       @if (IsVisible)
        {
        <div class="Panel">
			<div class="section2">

				<div class="items @((Inventory.IsDragging ? "dragging" : "inventory-scrollable"))">
					@for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
					{
						var item = Player.Local.Inventory.BackpackItems[index];
						<InventorySlot Item=@item BackpackSlotIndex=@index />
					}
				</div>
				<div style="align-items: center; margin: 20px 5px;"></div>
			</div>
			<div class="chest-inventory">
				<div class="items @((Inventory.IsDragging ? "dragging" : "inventory-scrollable"))">
					<div class="items">
						@for (var index = 0; index < itemStorage.Items.Count; index++)
						{
							var item = itemStorage.Items[index];
							<InventorySlot Item=@item IndependentSlotIndex=@index Type=@InventorySlot.SlotType.Chest/>
						}
					</div>
				</div>
				<div style="align-items: center; margin: 20px 5px;"></div>
			</div>

		</div>
		
        }
        
        
</root>

