@using GeneralGame
@using GeneralGame.HUD
@inherits Panel
@namespace GeneralGame.HUD



<root>
    @if (IsVisible)
    {
        <div class="Panel">
            <button class="Open">Open</button>
            <div>Hello</div>
        </div>
       
    }
</root>

@code
{
    public bool FromHands { get; set; }
    private static Dictionary<string, Interaction> priorityList = new();
    private bool isVisible = false;
    private void ToggleVisibility()
    {
        TogglePanel(!isVisible); // Umschalten der Sichtbarkeit
    }
    public ItemInteractable chest { get; set; }

    public override void Tick()
    {
        if (FromHands) priorityList.Clear();

        TogglePanel(isVisible); // Umschalten der Sichtbarkeit ohne Rückgabewert
        SetClass("visible", isVisible); // Verwenden des aktualisierten Zustands von isVisible

        if (!HasClass("visible"))
            return;
    }
    protected override int BuildHash()
    {
        // Kombinieren der HashCodes der relevanten Eigenschaften
        int hash = HashCode.Combine(isVisible, priorityList);

        // Optional: Weitere relevante Eigenschaften hinzufügen
        // Beispiel: hash = HashCode.Combine(hash, eineAndereEigenschaft);

        return hash;
    }

    public void TogglePanel(bool isVisibleArgument)
    {
        isVisible = isVisibleArgument; // Direktes Setzen des Zustands basierend auf dem Argument
        StateHasChanged(); // Aktualisieren des UI-Zustands
        Log.Info($"Panel Visibility set to {isVisible}");
    }

}