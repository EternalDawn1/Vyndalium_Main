@using GeneralGame
@using GeneralGame.HUD
@inherits PanelComponent
@namespace GeneralGame.HUD

@if (IsProxy) return;

<root>


    @if (IsPanelVisible)
    {
        <div class="Panel">
            <button class="Open">Open</button>
            <div>Hello</div>
        </div>
    }

</root>

@code {
    private bool IsPanelVisible { get; set; } = false;
    private ItemInteractable chest { get; set; }
    public new GameObject GameObject { get; private set; }
    public BaseInteractionHint()
    {
        InitializeGameObject();
    }

    private void InitializeGameObject()
    {
        // Initialisieren Sie Ihr GameObject hier
        GameObject = new GameObject();
        Log.Info("Hallo"); // Beispielinitialisierung
    }
    public void TogglePanel()
    {
        // Umschalten der Sichtbarkeit des Panels
        IsPanelVisible = !IsPanelVisible;
        StateHasChanged();
        Log.Info("Panel Visibility toggled to " + IsPanelVisible);

        // Stellen Sie sicher, dass GameObject und Components existieren
        if (this.GameObject != null && this.GameObject.Components != null)
        {
            var panel = this.GameObject.Components.Get<BaseInteractionHint>();
            // Entscheidung, ob das Highlight-Outline erstellt oder zerstört werden soll
            if (IsPanelVisible)
            {
                Log.Info("Panel Visibility is true");
            }
            else
            {
                if (panel != null)
                {
                    panel.Destroy();
                }
            }
        }
        else
        {
            if (GameObject == null)
            {
                Log.Error("GameObject ist null.");
                InitializeGameObject();
            }
            else if (Components == null)
            {
                Log.Error("Components ist null.");
            }
            else
            {
                Log.Error("Unbekannter Fehler: Sowohl GameObject als auch Components sollten nicht null sein.");
            }
        }
    }


}