@using GeneralGame
@using GeneralGame.HUD
@inherits PanelComponent
@namespace GeneralGame.HUD

@if (IsProxy) return;

<root>

    @if (IsPanelVisible)
    {
        <div class="Panel">
            <button class="Open"> Open </button>
            <div class="font">Hello</div>
        </div>
    }
</root>



@code
{

    private bool IsPanelVisible { get; set; } = false;

    private Chest chest { get; set; }
    public void TogglePanel()
    {
        IsPanelVisible = !IsPanelVisible;
        StateHasChanged();
        Log.Info("Toggle 2Panel Visibility toggled to " + IsPanelVisible); // Protokollierung
    }



}
