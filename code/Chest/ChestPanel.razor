@using GeneralGame
@using GeneralGame.HUD
@inherits PanelComponent
@namespace GeneralGame.HUD


@code
{
    public void OnHover()
    {
        var start = new Vector3(0, 0, 0); // Replace with the start point of the raycast
        var end = new Vector3(10, 10, 10); // Replace with the end point of the raycast
        var tr = Scene.Trace.Ray(start, end)
        .WithAnyTags("solid")
        .Run();
        if (!tr.Hit) return;
        if (tr.Hit)
        {
            Show();

        }

    }


    private float InteractionDistance = 10f;
    private float INTERACTION_SIZE = 100f;
    public static ChestPanel Instance { get; private set; }
    [Property] public float PlayerProximityDistance { get; set; } = 100f;
    public ChestPanel()
    {
        if (Instance == null)
        {
            Instance = this;
        }
    }
    public float GetInteractionSize()
    {
        return INTERACTION_SIZE;
    }

    [ConCmd("new_chest_toggle")]
    public static void ToggleChest()
    {
        if (Instance != null)
        {
            Instance.Enabled = !Instance.Enabled;
            // Fügen Sie Debugging-Logs hinzu, um zu überprüfen, ob diese Methode erreicht wird
            Log.Error($"ChestPanel Enabled Status: {Instance.Enabled}");
        }
        else
        {
            // Warnung ausgeben, wenn Instance null ist
            Log.Error("ChestPanel Instance ist null. ToggleChest kann nicht ausgeführt werden.");
        }
    }


    private Vector3 GetPosition()
    {
        // Beispielrückgabe, ersetzen Sie dies durch Ihre eigene Logik
        return Transform.Position;
    }
    public bool IsPlayerInRange(Vector3 playerPosition)
    {
        if (Network.IsProxy)
            return false;

        var players = Scene.GetAllComponents<Player>();
        foreach (var player in players)
        {
            // Korrektur: Berechne die Länge des Differenzvektors und vergleiche sie mit PlayerProximityDistance
            if ((player.Transform.Position - this.GetPosition()).Length < PlayerProximityDistance)
            {
                return true;
                Log.Info("Spieler in Reichweite");
            }
        }
        // Die Schleife sollte komplett durchlaufen werden, bevor false zurückgegeben wird
        return false;
        Log.Info("Spieler nicht in Reichweite");

        Vector3 chestPanelPosition = GetPosition();
        // Korrigieren Sie den Aufruf, um Vector3.DistanceBetween zu verwenden
        float distance = Vector3.DistanceBetween(playerPosition, chestPanelPosition);
        Log.Info($"Spielerabstand zum ChestPanel: {distance}, erforderliche Distanz: {InteractionDistance}");
        bool isInRange = distance <= InteractionDistance;
        Log.Info($"Ist Spieler in Reichweite: {isInRange}");
        return isInRange;
    }
    protected override void OnFixedUpdate()
    {

        if (Network.IsProxy)
            return;
        Vector3 playerPosition = GetCurrentPlayerPosition();
        if (!IsPlayerInRange(playerPosition)) // Überprüfen, ob ein Spieler in der Nähe ist
            return;


        HideInteractionHint();
    }
    private Vector3 GetCurrentPlayerPosition()
    {
        // Beispielimplementation, ersetzen Sie dies durch Ihre eigene Logik, um die Spielerposition zu erhalten
        return new Vector3(0, 0, 0); // Beispielwerte
    }
    public void Show()
    {
        Enabled = true; // Panel anzeigen
        if (ChestPanel.Instance != null)
        {
            ChestPanel.Instance.Show();
        }
        else
        {
            Log.Error("ChestPanel Instance ist null. Das Panel kann nicht angezeigt werden.");
        }
    }

    public void Hide()
    {
        Enabled = false; // Panel verstecken
    }
    public void ShowInteractionHint()
    {
        // Stellen Sie sicher, dass das Panel aktiviert ist
        Enabled = true;
        // Logik zum Anzeigen des Interaktionshinweises
        // Zum Beispiel: Setzen eines Textes oder Sichtbarmachen eines speziellen UI-Elements
        Log.Info("Drücke 'E' um zu interagieren.");
    }

    public void HideInteractionHint()
    {
        // Logik zum Verstecken des Interaktionshinweises
        // Zum Beispiel: Verstecken oder Deaktivieren des UI-Elements
        Enabled = false;
    }


}
