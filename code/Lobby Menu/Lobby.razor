@code {
   Hud hud = new Hud();
    private string GetTitleStyle(int playerLevel, int requiredLevel)
    {
        return playerLevel >= requiredLevel ? "color: green;" : "color: red;";
    }
    private void CloseMission()
    {
        Player.Local.BlockInputs = false;
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud);
    }

    private PanelType currentPanel = PanelType.CTier;

    private void ShowPanel(PanelType panel)
    {
        currentPanel = panel;
    }

    

    public enum PanelType
    {
       
        CTier,
        BTier,
        ATier,
        STier,
        SSTier,
        SSSTier,
        Bonus
    }
    private void InitializeRequiredLevel(GeneralScene2 scene)
    {
        requiredLevel = scene.GetRequiredLevel2();
        StateHasChanged();
    }
   
    private bool isSceneChanging = false;
   
    private int playerLevel = Player.Local.Level; 
    private int requiredLevel { get; set; }

   

    public static void ToggleReadyStatusOnServer(bool readyStatus)
    {
        // Logik zum Senden des Status an den Server
    }
     private string GetImagePath(int playerLevel, int requiredLevel, string normalImagePath, string fallbackImagePath)
    {
        StateHasChanged();
        return playerLevel >= requiredLevel ? normalImagePath : fallbackImagePath;
    }
   
    private void ChangeScene2(GeneralScene2 scene)
{
    if (isSceneChanging)
    {
        return;
    }

    var player = Player.Local;
    if (player == null)
    {
        Log.Error("Player.Local is null.");
        return;
    }

    if (!player.IsHost())
    {
        Log.Error("Player is not the host.");
        return;
    }

    if (isSceneChanging)
    {
        return;
    }

    int playerLevel = Player.Local.GetLevel();
    int requiredLevel = scene.GetRequiredLevel2();

    if (!SceneHandler2.HasRequiredLevel2(scene))
    {
        Hudmaster.Instance.ShowNotification(
            "lvl. " + playerLevel + "\n" +
            "required lvl. " + requiredLevel + "\n" +
            "level too low",
            "/ui/hud/exit.gif"
        );
        Player.Local?.PlaySuccessSoundFromPath("sounds/upgrade/error2.sound", 0.025f);
        return;
    }

    Player.Save();
    isSceneChanging = true;
    SceneHandler2.DeleteCurrentScene();

    // Hier die Logik zum tatsächlichen Wechsel der Szene hinzufügen
    // Beispiel:
    switch (scene)
    {
        case GeneralScene2.Forest:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.Game:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.Starting:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.StartBase:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.One:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.One2:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.One3:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.Forest3:
            SceneHandler2.ChangeScene2(scene);
            break;
        case GeneralScene2.Forest4:
            SceneHandler2.ChangeScene2(scene);
            break;
        default:
            Log.Info("No scene?");
            break;
    }
   

    isSceneChanging = false;
}
    
    // Beispielwert, ersetzen Sie dies durch die tatsächliche Spielerlevel-Variable

}