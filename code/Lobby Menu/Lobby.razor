@namespace GeneralGame.HUD
@attribute [StyleSheet]
@using System
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Sandbox
@using Sandbox.Network
@using GeneralGame

<root>
    <div class="main-panel">
        <div class="side-panel">
            <SideButton 
                Title="@(isReady ? "Ready" : "Not Ready")"
                Subtitle="@((isReady ? "Ready" : "not Ready"))" 
                OnClick="@ToggleReady" 
                ImagePath="@(isReady ? "ui/hud/success.gif" : "ui/hud/close.png")"
                SubtitleStyle="color: @(isReady ? "green" : "red");" 
                style="position: absolute; top: 0px; right: 0px; width: 100%;" 
            />
                
        </div>
        <div class="center-panel">
            <div class="map-panel">
                @if (Player.Local != null && Player.Local.IsHost() && (Player.All.Count >= 1 && Player.AreAllPlayersReady(true)))
                {
                    <div class="side">
                        <SideButton 
                            Title="Forest" 
                            Subtitle="min. lvl. 25" 
                            OnClick=@(() => ChangeScene2(GeneralScene2.Forest)) 
                            ImagePath="ui/hud/tree.png" 
                            style="position: absolute; top: 300px; right: 200px;" 
                        />
                        <SideButton 
                            Title="Dungeon" 
                            Subtitle="min lvl. 1" 
                            OnClick=@(() => ChangeScene2(GeneralScene2.Game)) 
                            ImagePath="ui/hud/hpball.png" 
                            style="position: absolute; top: 600px; right: 200px;" 
                        />
                         <SideButton 
                            Title="Dungeon 1-1" 
                            Subtitle="first Stage" 
                            OnClick=@(() => ChangeScene2(GeneralScene2.One)) 
                            ImagePath="ui/hud/storage.png" 
                            style="position: absolute; top: 700px; right: 200px;"
                        />
                        <SideButton 
                            Title="Destroyed Ship" 
                            Subtitle="min. lvl. 5" 
                            OnClick=@(() => ChangeScene2(GeneralScene2.Starting)) 
                            ImagePath="ui/hud/storage.png" 
                            style="position: absolute; top: 450px; right: 200px;" 
                        />
                        <SideButton 
                            Title="Dungeon 1-2" 
                            Subtitle="second Stage" 
                            OnClick=@(() => ChangeScene2(GeneralScene2.One2)) 
                            ImagePath="ui/hud/storage.png" 
                            style="position: absolute; top: 800px; right: 200px;"
                        />

                        <SideButton
                        Title="StartBase"
                        Subtitle="Home_Base"
                        OnClick=@(() => ChangeScene2(GeneralScene2.StartBase))
                        ImagePath="ui/hud/storage.png"
                        style="position: absolute; top: 900px; right: 200px;"
                        />
                       
                    </div>
                }
                
            </div>
        </div>
    </div>
</root>

@code {
   
   
    private bool isSceneChanging = false;
    private static bool isReady = false;
    
    private void ToggleReady()
    {
        isReady = !isReady;
        StateHasChanged();
        
        ToggleReadyStatusOnServer(isReady); // Neue Methode zum Senden des Status an den Server
    }
    private void ToggleReadyStatus()
    {
        isReady = !isReady;
        GeneralGame.Player.AreAllPlayersReady(isReady);
    }
    public static void ToggleReadyStatusOnServer( bool readyStatus )
        {
            var player = Player.Local;
            if ( player != null )
            {
                player.SetReadyStatus( readyStatus );
            }
        }
    
   

   

    

    private void ChangeScene2(GeneralScene2 scene)
        {
            if (isSceneChanging)
        {
            return;
        }
        var player = Player.Local;
        if (player == null)
        {
            Log.Error("Player.Local is null.");
            return;
        }
        if (isSceneChanging)
        {
            
            return;
        }
        if (!SceneHandler2.HasRequiredLevel2(scene))
    {
        int playerLevel = Player.Local.GetLevel();
        int requiredLevel = scene.GetRequiredLevel2();
        Log.Info("playerlevel: " + playerLevel + ", required Level: " + requiredLevel + "you can't enter this scene yet , level more!");
        return;
    }

        isSceneChanging = true;
        SceneHandler2.DeleteCurrentScene();
        
        // Hier die Logik zum tatsächlichen Wechsel der Szene hinzufügen
        // Beispiel:
        switch (scene)
        {
            case GeneralScene2.Forest:
                // Logik zum Wechseln zur Forest-Szene
                
                SceneHandler2.ChangeScene2(scene);
                break;
            case GeneralScene2.Game:
                // Logik zum Wechseln zur Game-Szene
               
                SceneHandler2.ChangeScene2(scene);
                break;
            case GeneralScene2.Starting:
                // Logik zum Wechseln zur Starting-Szene
              
                SceneHandler2.ChangeScene2(scene);
                break;
            case GeneralScene2.StartBase:
                // Logik zum Wechseln zur StartBase-Szene
            
                SceneHandler2.ChangeScene2(scene);
                break;

            case GeneralScene2.One:
                // Logik zum Wechseln zur One-Szene
               
                SceneHandler2.ChangeScene2(scene);
                break;
            case GeneralScene2.One2:
                // Logik zum Wechseln zur Two-Szene
               
                SceneHandler2.ChangeScene2(scene);
                break;
            default:
                Log.Info("No scene?");
                break;
        }

        isSceneChanging = false;
    }
    private int GetPlayerLevel()
    {
        return Player.Local.GetLevel(); // Annahme: Es gibt eine Methode, um das Spielerlevel zu bekommen
    }
    protected override int BuildHash()
        {
            
            return HashCode.Combine(
                
            isReady
            
            );
            
        }
}