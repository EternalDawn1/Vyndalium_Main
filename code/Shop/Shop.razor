@namespace GeneralGame.HUD
@attribute [StyleSheet]
@using System
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Sandbox
@using Sandbox.Network
@using GeneralGame

@if (Player.Local is null)
    return;

<root>
    <div class="Sidebutton">
        <SideButton 
            Title="Storage" 
            OnClick=@(() => ShowPanel(PanelType.Storage))
            IsInverted=@(true)
            Subtitle="Storage"
            ImagePath="ui/hud/storage.png"
            style="position: absolute; top: -300px; right: 300px;" 
        />
        <SideButton 
            Title="Shop" 
            OnClick=@(() => ShowPanel(PanelType.Shop))
            IsInverted=@(true)
            Subtitle="Shop"
            ImagePath="ui/hud/vynd.png"
            style="position: absolute; top: -600px; right: 300px;" 
        />
        <SideButton 
            Title="Refinement" 
            OnClick=@(() => ShowPanel(PanelType.Refinement))
            IsInverted=@(true)
            Subtitle="Refinement"
            ImagePath="ui/hud/sword.png"
            style="position: absolute; top: -900px; right: 300px; "
        />
       
        <SideButton
        Title="Forge"
        Subtitle="Forge"
        OnClick=@(() => ShowPanel(PanelType.Forge))
        IsInverted=@(true)
        ImagePath="ui/hud/forge.png"
        style="position: absolute; top: -1200px; right: 300px;"
        />
        <SideButton
        Title="Factory"
        Subtitle="Factory"
        OnClick=@(() => ShowPanel(PanelType.Factory))
        IsInverted=@(true)
        ImagePath="ui/hud/forge.png"
        style="position: absolute; top: -500px; right: 300px;"
        />
    </div>

    <div class="list">
        <div class="Shop" style="opacity: @(currentPanel == PanelType.Shop ? 1 : 0)">
            <button class="h1">
                Shop
            </button>
            <div class="h2" @onclick="@OpenSellPanel"> 
                Sell  
            </div>
            <div class="h2" @onclick="@OpenBuyPanel">
                Buy 
            </div>
            
            @if(isBuyPanelOpen && ItemsForSale != null && ItemsForSale.Any())
            {
                <div class="buypanel">
                    @foreach (var item in ItemsForSale)
                    {
                        if (item != null)
                        {
                            <div class="buypanelpanel">
                                <p class="itemname">@item.Name</p>
                                <p class="itemprice">@item.Price Vyndalium</p>
                                <button class="bu" @onclick="@(() => BuyItem(item))">Purchase</button>
                                
                                
                            </div>
                        }
                    }
                </div>
            }

            @if(isSellPanelOpen && player?.Inventory?.BackpackItems != null)
            {
                <div class="sellpanel">
                    @foreach (var item in player.Inventory.BackpackItems)
                    {
                        <div class="slots">@item.Name</div>
                        <button class="sslots" @onclick="() => SellItem(item)">
                            Sell for @item.Price Vyndalium
                        </button>
                    }
                </div>
            }
        </div>

        <div class="Storage" style="opacity: @(currentPanel == PanelType.Storage ? 1 : 0)">
            <button class="h1">
                Storage Content
            </button>
            <div class="StorageMenu">
                <button class="storageslots">
                    1
                </button>
                <button class="storageslots">
                    2
                </button>
                <button class="storageslots">
                    3
                </button>
            </div>
        </div>

        <div class="Refinement" style="opacity: @(currentPanel == PanelType.Refinement ? 1 : 0)">
            Refinement Content
        </div>
        
        <div class="Forge" style="opacity: @(currentPanel == PanelType.Forge ? 1 : 0)">
            Forge Content
        </div>
        <div class="Factory" style="opacity: @(currentPanel == PanelType.Factory ? 1 : 0);">
            Factory Content
            <div class="Printer">
                
            </div>
        </div>
    </div>
</root>

@code
{
    


    /////
    Action<ItemComponent> buyItemAction;
    private Inventory Inventory { get; set; }
    private Shop shop { get; set; }
    public List<ItemComponent> items { get; set; }
    bool isBuyPanelOpen = false;
    bool isSellPanelOpen = false;
    

    private void OpenBuyPanel() {
        isBuyPanelOpen = true;
        isSellPanelOpen = false;
    }

    private void OpenSellPanel() {
        isSellPanelOpen = true;
        isBuyPanelOpen = false;
    }

    private Player player { get; set; }
    public enum PanelType
    {
        Shop,
        Storage,
        Refinement,
        Forge,
        Factory
    }
    private PanelType currentPanel = PanelType.Shop;

    public void ShowPanel(PanelType panel)
    {
        currentPanel = panel;
    }

    private void Buy(string itemName)
    {
        if (player == null || items == null)
        {
            return;
        }

        var itemToBuy = items.FirstOrDefault(i => i.Name == itemName);
        if (itemToBuy != null)
        {
            // Continue with the buying process
        }
    }

    private void Sell(ItemComponent item)
    {
        ItemsForSale.Remove(item);
    }

    private async void BuyItem(ItemComponent item)
    {
        Log?.Info($"BuyItem called with item: {item?.Name}"); 
        Confirm.Instance.SelectedItem = item;
        bool confirmed = await Confirm.Instance.ShowConfirmationDialog(item);
        Log?.Info($"ShowConfirmationDialog returned: {confirmed}");

        if (confirmed)
        {
            // Wenn der Kauf bestätigt wurde, ziehen Sie den Preis des Artikels von Vyndalium ab und fügen Sie den Artikel dem Inventar des Spielers hinzu
            if (player.TrySpendVyndalium(item.Price))
            {
                player.Vyndalium -= item.Price;
                player.Inventory.GiveItem(item);
            }
        }
    }
    Confirm confirm = new Confirm();

    private void SellItem(ItemComponent item)
    {
        ItemsForSale.Add(item);
        // Increase user's balance by item's price
    }
    private ItemComponent selectedItem;
    private void SelectItem(ItemComponent item)
    {
        Log.Info("Item selected: " + item.Name);
        selectedItem = item;
    }

    public List<ItemComponent> ItemsForSale { get; set; }

    public Shop()
    {
        buyItemAction = BuyItem;
        ItemsForSale = new List<ItemComponent>
        {
            new ItemComponent { Name = "Glock", Price = 20 },
            new ItemComponent { Name = "AK74", Price = 50 },
            new ItemComponent { Name = "Ammo", Price = 15 },
        };
    }
    public Hud hud { get; set; }

    

    
}
