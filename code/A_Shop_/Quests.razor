@inherits Panel
@using GeneralGame
@namespace GeneralGame.HUD

<root>
    <button class="exit-button" @onclick="@(() => shopStorage.CloseQuest())"></button>
    <div class="quests">
        <div class="quests__header">
            <h1>Quests</h1>
        </div>
        <div class="quests__header">
            <h1>Active Quests</h1>
        </div>

        <div class="quests-content">
            <div class="box">
                <div class="name">Quest</div>
                <div class="level">Lvl.5</div>
                <div class="description">Test</div>
                
                <div class="reward">Test</div>

                <button class="button">Accept</button>

            </div>
        </div>
        
           
        
    </div>
</root>


@code{

    /// <summary>
    /// Main Thread
    /// </summary>

    public static Quests Instance { get; private set; }
    private ShopStorage shopStorage;
    public Quests()
    {
        Instance = this;
        shopStorage = new ShopStorage(); // Initialisieren Sie shopStorage hier oder injizieren Sie es
    }

    /// <summary>
    /// Properties
    /// </summary>
}