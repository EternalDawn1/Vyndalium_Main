@inherits Panel
@using GeneralGame
@namespace GeneralGame.HUD
<root>
    <button class="exit-button" @onclick="@(() => @CloseQuest())"></button>
    <div class="quests">
        <div class="quests__header">
            <h1>Quests</h1>
        </div>
        <div class="quests__header">
            <h1>Active Quests</h1>
        </div>
        <div class="quests-content">
            @if (QuestManager != null)
            {
                @foreach (var quest in QuestManager.ActiveQuests)
                {
                    <div class="box">
                        <div class="name">@quest.Title</div>
                        <div class="description">@quest.Description</div>
                        @if (quest.IsCompleted)
                        {
                            <div class="status">Completed</div>
                            <button @onclick="@(() => quest.ClaimRewards())">Claim Rewards</button>
                        }
                        else
                        {
                            <div class="status">In Progress</div>
                        }
                    </div>
                }
            }
            else
            {
                <div>Loading quests...</div>
            }
        </div>
    </div>
</root>

@code {
    public static Quests Instance { get; private set; }

    public Quest quest2 { get; set; }
    public QuestManager QuestManager { get; set; }
    private QuestInteraction shopStorage;
    public bool IsOpened { get; set; }

    protected override void OnAfterTreeRender(bool firstRender)
    {
        if (firstRender)
        {
            QuestManager = new QuestManager();
            QuestManager.LoadQuestsFromResources();
        }
    } 

    public void OpenQuest()
        {
            Log.Info( "Quests Panel Opened" );
            if ( !IsOpened )
            {
                FullScreenManager.Instance.Display( FullScreenManager.FullScreenPanel.Quests );
                IsOpened = true;
                //Player.Local.BlockInputs = true;
            }
            else
            {
                CloseQuest();
            }
        }
        public void CloseQuest()
        {
            Player.Local.BlockInputs = false;
            FullScreenManager.Instance.Display( FullScreenManager.FullScreenPanel.InGameHud );
            IsOpened = false;
        }

    public Quests()
    {
        Instance = this;
        shopStorage = new QuestInteraction();
    }
}