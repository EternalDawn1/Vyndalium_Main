@inherits Panel
@using GeneralGame
@namespace GeneralGame.HUD
<root>
    

    <div class="sidehud">
        <SideButton OnClick=@(() => ShowPanel(PanelType.Inventory)) 
            IsInverted=@(true) 
            ImagePath="ui/hud/inventory.png" 
            title="Sell" 
            TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;"   
            />
        <SideButton OnClick=@(() => ShowPanel(PanelType.StoreItems)) IsInverted=@(true) ImagePath="ui/hud/storage.png" title="Storage" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;"    />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Weapons)) IsInverted=@(true) ImagePath="ui/hud/weapons.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Armor)) IsInverted=@(true) ImagePath="ui/hud/armor.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Accessories)) IsInverted=@(true) ImagePath="ui/hud/money.gif" title="Shop" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;"    />
    </div>
    <button class="exit-button" @onclick="@(() => shopStorage.CloseShop())"></button>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Inventory ? 1 : 0)">
        <div class="panel-content-text">
            <div class="panel-content-layout">
                <div class="main-panel">
                    <div class="Panel">
                        
                        <div class="section2">
                            
                            <div class="title">Inventory</div>
                                <div class="title0">
                                    <button class="toggle" @onclick="@ToggleInventorySortOptions">Sort</button>
                                </div>
                            
                            <div class="box-information-main">
                                
                                <div class="box-information">
                                 
                                    <div class="box-description"><div class="icon2"></div> to Sell Items</div>
                                    <div class="box-description"><div class="icon"></div> to Select Items </div>
                                    

                                </div>
                            </div>
                            <div class="tier-selection">
                            <div class="tier-title">Select by Tier:</div>
                            <div class="tier-buttons">
                                <button class="tier-button tier-c" @onclick="@(() => SelectItemsByTier(Tier.C))">C</button>
                                <button class="tier-button tier-b" @onclick="@(() => SelectItemsByTier(Tier.B))">B</button>
                                <button class="tier-button tier-a" @onclick="@(() => SelectItemsByTier(Tier.A))">A</button>
                                <button class="tier-button tier-s" @onclick="@(() => SelectItemsByTier(Tier.S))">S</button>
                                <button class="tier-button tier-ss" @onclick="@(() => SelectItemsByTier(Tier.SS))">SS</button>
                                <button class="tier-button tier-sss" @onclick="@(() => SelectItemsByTier(Tier.SSS))">SSS</button>
                                <button class="tier-button clear" @onclick="@ClearSelection">Clear</button>
                            </div>
                        </div>
                            <div class="items0" CanDragScroll="false">
                                @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                                {
                                    var item = Player.Local.Inventory.BackpackItems[index];
                                    <InventorySlot Item=@item BackpackSlotIndex=@index />
                                }
                            </div>
                            @if (showInventorySortOptions)
                            {
                                <div class="box2">
                                    <button class="sort" @onclick="@(() => @SortBackPackItems(SortOption.Tier))">Tier</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.ItemLevel))">Item Level</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.RequiredLevel))">Req
                                            Level</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.Material))">Type</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.Favorite))">Fav</button>
                                </div>
                            }
                            
                            <div class="items2 @((Inventory.IsDragging ? "dragging" : "inventory-scrollable"))">

                            @{
                                var backpackBagItems = Player.Local.Inventory.BackpackBagItems;
                             }
                            @for (var index = 0; index < backpackBagItems.Count; index++)
                            {
                                var item = backpackBagItems[index];
                                <InventorySlot Item=@item BackpackPackSlotIndex=@index IsSelected=@selectedItems.Contains(item)/>
                            }
                            
                            </div>
                            <div class="money">$@Player.Local.Vyndalium.ToString("N0")</div>
                            <div style="align-items: center; margin: 20px 5px;"></div>

                           
                            
                                @if (selectedItems.Count > 0)
                                {
                                    <div class="sell-info">
                                        <div class="sell-amount"> $@selectedItems.Sum(item => item.SellPrice).ToString("N0")</div>
                                        <button class="sell-button" @onclick="@SellSelectedItems">Sell Selected</button>
                                    </div>
                                }
                                
                            
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.StoreItems ? 1 : 0)">
    <div class="panel-content-text">
        <div class="panel-content-layout">
            <div class="main-panel">
                <div class="Panel">
                    <div class="section2">
                        <div class="title-container">
                                
                                <div class="title0">Inventory
                                    <button class="toggle" @onclick="@ToggleInventorySortOptions"></button>
                                </div>
                                <div class="title0">Storage
                                    <button class="toggle" @onclick="@ToggleStorageSortOptions"></button>
                                </div>
                        </div>
                        <div class="box-information-main">
                                <div class="box-information" style="bottom: 20%; gap: 10%;">
                                   
                                    <div class="box-description"><div class="icon2"></div> to Store Items from Inventory</div>
                                     <div class="box-description"><div class="icon2"></div> to Store Items from Storage</div>
                                        <div class="box-description"><div class="icon2"></div> to Sell Items </div>
                                    

                                </div>
                            </div>
                        <div class="items-container">
                            <div class="items2" CanDragScroll="false">
                                @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                                {
                                    var item = Player.Local.Inventory.BackpackItems[index];
                                    <InventorySlot Item=@item BackpackSlotIndex=@index />
                                }
                            </div>
                            <div class="items2">
                            @for (var index = currentPage * itemsPerPage; index < (currentPage + 1) * itemsPerPage && index < Player.Local.Inventory.StorageItems.Count; index++)
                            {
                                var item = Player.Local.Inventory.StorageItems[index];
                                <InventorySlot Item=@item StorageSlotIndex=@index />
                            }
                            </div>

                            <div class="pagination-controls">
                                <button @onclick="@PreviousPage" disabled="@(currentPage == 0)">Previous</button>
                                <span>Page @(currentPage + 1) of @totalPages</span>
                                <button @onclick="@NextPage" disabled="@(currentPage == totalPages - 1)">Next</button>
                            </div>
                            @if (showStorageSortOptions)
                            {
                                <div class="box">
                                    <button class="sort" @onclick="@(() => @SortStorageItems(SortOption.Tier))">Tier</button>
                                    <button class="sort" @onclick="@(() => @SortStorageItems(SortOption.ItemLevel))">Item Level</button>
                                    <button class="sort" @onclick="@(() => @SortStorageItems(SortOption.RequiredLevel))">Req Level</button>
                                    <button class="sort" @onclick="@(() => @SortStorageItems(SortOption.Material))">Type</button>
                                    <button class="sort" @onclick="@(() => @SortStorageItems(SortOption.Favorite))">Fav</button>
                                </div>
                            }

                            @if (showInventorySortOptions)
                            {
                                <div class="box2">
                                    <button class="sort" @onclick="@(() => @SortBackPackItems(SortOption.Tier))">Tier</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.ItemLevel))">Item Level</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.RequiredLevel))">Req
                                            Level</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.Material))">Type</button>
                                        <button class="sort"
                                            @onclick="@(() => @SortBackPackItems(SortOption.Favorite))">Fav</button>
                                </div>
                            }
                        </div>
                            

                        <div style="align-items: center; margin: 20px 5px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Weapons ? 1 : 0)">
    <div class="panel-content-text">
        <div class="panel-content-layout">  
            <div class="upgrade-section">
                
                    <div class="title" style="color:blue">Upgrade</div>
              
                        <div class="items2" CanDragScroll="false">
                        
                                    @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                                    {
                                        var item = Player.Local.Inventory.BackpackItems[index];
                                        <InventorySlot Item=@item BackpackSlotIndex=@index />
                                    }
                        </div>
                    <div class="upgrade-slot">
                        
                        <div class="title4" style="color:blue">Equipment</div>
                        <div class="items2">
                            @for (var index = 0; index < Player.Local.Inventory.UpgradeItems.Count; index++)
                            {
                                var item = Player.Local.Inventory.UpgradeItems[index];
                                <InventorySlot Item=@item UpgradeSlotIndex=@index />
                            }
                        </div>
                    </div>
                    <div class="iteminformation">
                                @if(Item != null)
                                {
                                    <ItemInformation Item=@Item style="max-width: 700px;" />
                                }
                                    
                            </div>
                    <div class="money">$@Player.Local.Vyndalium.ToString("N0")</div>
                    
                    @if (isUpgradePanelVisible)
                    {
                        <div class="upgrade-panel @(isUpgradePanelVisible ? "visible" : "")">
                            <p class="upgrade-cost">Upgrade Cost:
                            <p class="number">$@upgradeCost</p>
                            </p>
                            <p class="upgrade-level">lvl. @upgradeItem.ItemLevel >>> lvl. @(upgradeItem.ItemLevel + 1)</p>
                            @{
                                var (totalMaterialsText, missingMaterialsText) = GetRequiredMaterialsText();
                            }
                            <p class="upgrade-level"
                                style="font-size: 16px; flex-direction: column; background-color: rgb(109, 109, 109);">
                                Required Materials:
                            <div class="total-materials">
                                <p class="number">@totalMaterialsText</p>
                            </div>
                                @if (!string.IsNullOrEmpty(missingMaterialsText))
                                {
                                <div class="missing-materials">
                                    <p class="number">@missingMaterialsText</p>
                                </div>
                                }
                            </p>
                            <p class="upgrade-level"
                                style="background-color: @(GetBackgroundColor(upgradeItem?.SuccessChance ?? 0)); font-size: 20px; height: 80%;">
                                <span id="status-text" class="@statusClass">@statusText</span>
                            <p class="number">@((upgradeItem != null) ? $"{upgradeItem.SuccessChance * 100:F1}%" : "0%")</p>
                            </p>
                            <button class="upgrade-button" @onclick="@(() => ShowUpgradeConfirmation(UpgradeItem))"
                                disabled="@(Player.Local.Vyndalium < upgradeCost || upgradeItem.ItemLevel >= 27)">Upgrade</button>
                            
                            
                            </p>
                        </div>
                    }
                    @if (ShowUpgradeConfirmationDialog)
                    {
                        <div class="confirmation-dialog">
                            <div class="confirmation-content">
                                <p>Are you sure you want to upgrade this item?</p>
                                <p>This action cannot be undone!</p>
                                <button class="confirmation-button" @onclick="@ConfirmUpgrade">Yes</button>
                                <button class="confirmation-button" @onclick="@CancelUpgrade">No</button>
                            </div>
                        </div>
                    }
                    @if (ShowUpgradeResultDialog)
                    {
                        <div class="upgrade-result-dialog">
                            <div class="upgrade-result-content @UpgradeResultClass">
                                <p>@UpgradeResultMessage</p>
                                <button class="upgrade-result-button" @onclick="@CloseUpgradeResult">Close</button>
                            </div>
                        </div>
                    }


                    
                

                
            </div>
        </div>
    </div>
    </div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Armor ? 1 : 0)">
        <div class="panel-content-text">
            <div class="panel-content-layout">
                <div class="upgrade-section">
                    <div class="title" style="color:blue">Aspect</div>
                    <div class="items2" CanDragScroll="false">
                        @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                        {
                            var item = Player.Local.Inventory.BackpackItems[index];
                            <InventorySlot Item=@item BackpackSlotIndex=@index />
                        }
                    </div>
                    <div class="upgrade-slot">
                        <div class="title4" style="color:blue">Equipment</div>
                        <div class="items2">
                            @for (var index = 0; index < Player.Local.Inventory.UpgradeItems.Count; index++)
                            {
                                var item = Player.Local.Inventory.UpgradeItems[index];
                                <InventorySlot Item=@item UpgradeSlotIndex=@index />
                            }
                        </div>
                        
                    </div>
                    <div class="iteminformation">
                                @if(Item != null)
                                {
                                    <ItemInformation Item=@Item style="max-width: 700px;" />
                                }
                                    
                            </div>
                    
                    <div class="upgrade-slot" style="left: 65%; background-color: rgba(255, 0, 0, 0); top: 45%;">
                        <div class="title4" style="color:blue">Aspect</div>
                        <div class="items2">
                            @for (var index = 0; index < Player.Local.Inventory.AspectItems.Count; index++)
                            {
                                var item = Player.Local.Inventory.AspectItems[index];
                                <InventorySlot Item=@item AspectSlotIndex=@index />
                            }

                        </div>
                    </div>
                    <div class="money">$@Player.Local.Vyndalium.ToString("N0")</div>
                    
                    @if (isAspectPanelVisible)
                    {
                        <div class="aspect-panel @(isAspectPanelVisible ? "visible" : "")">
                            <p class="aspect-cost">Aspect Cost:
                            <p class="number">$@aspectCost</p>
                            </p>
                          
                            <p class="aspect-level"
                                style="background-color: @(GetBackgroundColor(aspectSuccessChance)); font-size: 20px; height:10%;">
                                <span id="status-text" class="@statusClass">@statusText</span>
                            <p class="number">@($"{aspectSuccessChance * 100:F1}%")</p>
                            </p>
                            <button class="aspect-button" @onclick="@(() => ShowAspectConfirmation(aspectItem))"
                                disabled="@(Player.Local.Vyndalium < aspectCost)">Apply Aspect</button>
                            
                            </p>
                        </div>
                    }

                    
                    
                    
                </div>
                <!-- Armor Content -->
            </div>
        </div>
    </div>

   <div class="panel-content" style="opacity: @(currentPanel == PanelType.Accessories ? 1 : 0)">
        <div class="panel-content-text">
        <div class="panel-content-layout">
            <div class="main-panel">
                <div class="Panel">
                    <div class="section2">
                        <div class="title" style="color:rgb(255, 255, 255)">Item Shop</div>
                            <div class="money">$@Player.Local.Vyndalium.ToString("N0")</div>
                        <div class="items-container2">
                            <div class="items3">
                                
                                <div class="box">
                                      <div class="title3">Potions</div>
                                    <div class="potions">
                                        @for (var index = 0; index < 10; index++) // 10 Slots für den Shop
                                        {
                                            var item = (index < shopStorage.AvailableItems.Count) ? shopStorage.AvailableItems[index] : null;
                                            <InventorySlot Item=@item ShopSlotIndex=@index />
                                        }
                                    </div>
                                  
                                </div>

                                <div class="box">
                                    <div class="title3">Equipment</div>
                                    <div class="weapon">
                                        
                                        @for (var index = 0; index < 5; index++) // 5 Slots für den Shop
                                        {
                                            var item = (index < shopStorage.WeaponItems.Count) ? shopStorage.WeaponItems[index] : null;
                                            <InventorySlot Item=@item ShopSlotIndex=@index />
                                        }
                                    </div>
                                    
                                </div>

                                <div class="box">
                                       <div class="title3">Armor</div>
                                    <div class="armor">
                                        @for (var index = 0; index < 5; index++) // 5 Slots für den Shop
                                        {
                                            var item = (index < shopStorage.ArmorItems.Count) ? shopStorage.ArmorItems[index] : null;
                                            <InventorySlot Item=@item ShopSlotIndex=@index />
                                        }
                                    </div>
                                 
                                </div>

                                <div class="box">
                                    <div class="title3">Materials</div>
                                    <div class="materials">
                                        @for (var index = 0; index < 3; index++) // 3 Slots für den Shop
                                        {
                                            var item = (index < shopStorage.MaterialItems.Count) ? shopStorage.MaterialItems[index] : null;
                                            <InventorySlot Item=@item ShopSlotIndex=@index />
                                        }
                                    </div>
                                    
                                </div>

                                <div class="box">
                                     <div class="title3">Accessories</div>
                                    <div class="accessories">
                                        @for (var index = 0; index < 5; index++) // 5 Slots für den Shop
                                        {
                                            var item = (index < shopStorage.AccessoryItems.Count) ? shopStorage.AccessoryItems[index] : null;
                                            <InventorySlot Item=@item ShopSlotIndex=@index />
                                        }
                                    </div>
                                   
                                </div>

                                <div class="box">
                                        <div class="title3">Consumables</div>
                                    <div class="consumables">
                                        @for (var index = 0; index < 5; index++) // 5 Slots für den Shop
                                        {
                                            var item = (index < shopStorage.ConsumableItems.Count) ? shopStorage.ConsumableItems[index] : null;
                                            <InventorySlot Item=@item ShopSlotIndex=@index />
                                        }
                                    </div>
                                
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    
</root>