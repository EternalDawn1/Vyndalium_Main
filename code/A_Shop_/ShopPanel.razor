@inherits Panel
@using GeneralGame
@namespace GeneralGame.HUD
<root>
    

    <div class="sidehud">
        <SideButton OnClick=@(() => ShowPanel(PanelType.Inventory)) 
            IsInverted=@(true) 
            ImagePath="ui/hud/inventory.png" 
            title="Sell" 
            TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;"   
            />
        <SideButton OnClick=@(() => ShowPanel(PanelType.StoreItems)) IsInverted=@(true) ImagePath="ui/hud/storage.png" title="Storage" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;"    />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Weapons)) IsInverted=@(true) ImagePath="ui/hud/weapons.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Armor)) IsInverted=@(true) ImagePath="ui/hud/armor.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Accessories)) IsInverted=@(true) ImagePath="ui/hud/money.gif" title="Shop" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;"    />
    </div>
    <button class="exit-button" @onclick="@(() => shopStorage.CloseShop())"></button>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Inventory ? 1 : 0)">
        <div class="panel-content-text">
            <div class="panel-content-layout">
                <div class="main-panel">
                    <div class="Panel">
                        
                        <div class="section2">
                            
                            <div class="title">Inventory</div>
                            <div class="title2">Sell</div>
                            <div class="items0">
                                
                                
                                @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                                {
                                    var item = Player.Local.Inventory.BackpackItems[index];
                                    <InventorySlot Item=@item BackpackSlotIndex=@index />
                                }
                            </div>
                            <div style="align-items: center; margin: 20px 5px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.StoreItems ? 1 : 0)">
    <div class="panel-content-text">
        <div class="panel-content-layout">
            <div class="main-panel">
                <div class="Panel">
                    <div class="section2">
                        <div class="title-container">
                                
                                <div class="title0">Inventory</div>
                                <div class="title0">Storage</div>
                        </div>
                        <div class="items-container">
                            <div class="items2">
                                @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                                {
                                    var item = Player.Local.Inventory.BackpackItems[index];
                                    <InventorySlot Item=@item BackpackSlotIndex=@index />
                                }
                            </div>
                            <div class="items2">
                                @for (var index = 0; index < Player.Local.Inventory.StorageItems.Count; index++)
                                {
                                    var item = Player.Local.Inventory.StorageItems[index];
                                    <InventorySlot Item=@item StorageSlotIndex=@index />
                                }
                            </div>
                        </div>
                        <div style="align-items: center; margin: 20px 5px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Weapons ? 1 : 0)">
        <div class="panel-content-text">
            <div class="panel-content-layout">
                <!-- Weapons Content -->
            </div>
        </div>
    </div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Armor ? 1 : 0)">
        <div class="panel-content-text">
            <div class="panel-content-layout">
                <!-- Armor Content -->
            </div>
        </div>
    </div>

    <div class="panel-content" style="opacity: @(currentPanel == PanelType.Accessories ? 1 : 0)">
        <div class="panel-content-text">
        <div class="panel-content-layout">
            <div class="main-panel">
                <div class="Panel">
                    <div class="section2">
                        <div class="title">Item Shop</div>
                        <div class="items-container">
                            <div class="items3">
                            
                                    
                                <div>Potions</div>
                                <div class="potions">
                                    @for (var index = 0; index < 10; index++) // 10 Slots für den Shop
                                    {
                                        var item = (index < shopStorage.AvailableItems.Count) ? shopStorage.AvailableItems[index] : null;
                                        <InventorySlot Item=@item ShopSlotIndex=@index />
                                    }
                                </div>
                                <div>Weapons</div>    
                                <div class="weapon">
                                    @for (var index = 0; index < 5; index++) // 10 Slots für den Shop
                                    {
                                        var item = (index < shopStorage.WeaponItems.Count) ? shopStorage.WeaponItems[index] : null;
                                        <InventorySlot Item=@item ShopSlotIndex=@index />
                                    }
                                </div>
                                <div>Armor</div>
                                <div class="armor">
                                    @for (var index = 0; index < 5; index++) // 10 Slots für den Shop
                                    {
                                        var item = (index < shopStorage.ArmorItems.Count) ? shopStorage.ArmorItems[index] : null;
                                        <InventorySlot Item=@item ShopSlotIndex=@index />
                                    }
                                </div>
                                <div>Accessories</div>
                                <div class="accessories">
                                    @for (var index = 0; index < 5; index++) // 10 Slots für den Shop
                                    {
                                        var item = (index < shopStorage.AccessoryItems.Count) ? shopStorage.AccessoryItems[index] : null;
                                        <InventorySlot Item=@item ShopSlotIndex=@index />
                                    }
                                </div>
                                <div>Consumables</div>
                                <div class="consumables">
                                    @for (var index = 0; index < 4; index++) // 10 Slots für den Shop
                                    {
                                        var item = (index < shopStorage.ConsumableItems.Count) ? shopStorage.ConsumableItems[index] : null;
                                        <InventorySlot Item=@item ShopSlotIndex=@index />
                                    }
                                </div>
                                <div>Materials</div>
                                <div class="materials">
                                    @for (var index = 0; index < 3; index++) // 10 Slots für den Shop
                                    {
                                        var item = (index < shopStorage.MaterialItems.Count) ? shopStorage.MaterialItems[index] : null;
                                        <InventorySlot Item=@item ShopSlotIndex=@index />
                                    }
                                </div>
                            
                            </div>
                        <div style="align-items: center; margin: 20px 5px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    
</root>