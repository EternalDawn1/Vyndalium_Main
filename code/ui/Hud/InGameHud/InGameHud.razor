@namespace GeneralGame.HUD
@inherits Panel
@using GeneralGame.HUD
@using GeneralGame
@using Sandbox;
@using Sandbox.UI;

<root>
    <InteractionHint />

    <div class="lobby-overlay" style="opacity: @(ShowRespawnOption ? 1 : 0);">
        @if (ShowReturnToLobby)
        {
            <div class="lobby-content">
                <h1 class="game-over-title">Game Over</h1>
                <p class="game-over-subtitle">No Hearts left</p>
                <button class="restart-button" @onclick="@ReturnToLobby">Restart</button>
            </div>
        }
    </div>
</root>

@code
{
    public static InGameHud Instance { get; private set; }

    public InGameHud()
    {
        Instance = this;
    }

    [Property]
    public GeneralScene2 SceneToLoad { get; set; } = GeneralScene2.StartBase;
    [Property] public bool ShowReturnToLobby { get; set; } = false;
    [Property] public bool ShowRespawnOption { get; set; } = false;

    private void ReturnToLobby()
    {
        var player = Player.Local;
        if (player == null)
        {
            Log.Error("Player.Local is null.");
            return;
        }

        if (!player.IsHost())
        {
            Log.Error("Player is not the host.");
            return;
        }

        ShowReturnToLobby = false;
        ShowRespawnOption = false;
        SceneHandler2.ChangeScene2(SceneToLoad);
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(ShowReturnToLobby, ShowRespawnOption);
    }
}
