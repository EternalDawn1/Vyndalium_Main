@inherits PanelComponent
@using Sandbox
@using Sandbox.UI
@using Sandbox.UI.Construct
@using GeneralGame.HUD
@using Editor

@namespace GeneralGame.HUD

<root>
	<div class="pause-menu @(PausePanelEnabled ? "enabled" : "disabled")">
		<div class="pause-menu-content @(PausePanelEnabled ? "enabled" : "disabled")">
			<div class="boy">
				<div class="pause-menu-pic"></div>
				<div class="pause-menu-title">Pause Menu</div>
				
				<div class="pause-menu-buttons">
					<button class="pause-menu-button" @onclick="@ExitGame">Resume</button>
					<div class="pause-menu-button" @onclick="@(() => @Game.Overlay.ShowBinds())">Controls</div>
					<button class="pause-menu-button" @onclick="@(() => @Game.Overlay.ShowSettingsModal())">Settings</button>
					<button class="pause-menu-button" @onclick="@OpenSettingsDialog">Ingame Settings</button>
					<button class="pause-menu-button" @onclick="@ConfirmKillPlayer">Suicide</button>
					<button class="pause-menu-button" @onclick="@AbandonGame">Back to Lobby</button>
					<button class="pause-menu-button" @onclick="@Quit">Exit</button>
					
					

				</div>


			</div>
			
			
		</div>
		<div class="pause-menu-content2 @(PausePanelEnabled ? "enabled" : "disabled")">
			<div class="boy2">
				<div class="discord">
					
						<div class="discord-title">Discord</div>
						<div class="discord-title2"></div>
						<div class="discord-buttons">
						<button class="discord-button" @onclick="@JoinDiscord">Join</button>
						<button class="discord-button">Discord link: </button>
						<button class="discord-button">https://discord.gg/vitrolicwithering</button>
						</div>
				</div>

			</div>
		</div>
	</div>
	@if (ShowConfirmationDialog)
	{
		<div class="confirmation-dialog">
			<div class="confirmation-content">
				<p>Are you sure you want to quit ?</p>
				<p>unsaved Progress will be lost!</p>
				<button class="confirmation-button" @onclick="@ConfirmQuit">Exit</button>
				<button class="confirmation-button" @onclick="@CancelQuit">No</button>
			</div>
		</div>
	}
	@if(ShowAbandonDialog)
	{
		<div class="confirmation-dialog">
			<div class="confirmation-content">
				<p>Are you sure you want to abandon the game ?</p>
				<p>unsaved Progress will be lost!</p>
				<button class="confirmation-button" @onclick="@Abondon">Abandon</button>
				<button class="confirmation-button" @onclick="@CancelAbandon">No</button>
			</div>
		</div>
	}

 	@if (ShowDiscordPanel)
     {
        <div class="webpanel-container">
            <WebPanel Url="https://discord.gg/vitrolicwithering" />
			<button class="close-webpanel-button" @onclick="@CloseDiscordPanel">Close</button>
        </div>
		
    }
	@if (ShowConfirmationDialogKill)
	{
		<div class="confirmation-dialog">
			<div class="confirmation-content">
				<div class="confirmation-message">Are you sure you want to kill the player?</div>
				<div class="confirmation-buttons">
					<button class="confirmation-button" @onclick="@KillPlayerConfirmed">Yes</button>
					<button class="confirmation-button" @onclick="@CancelKillPlayer">No</button>
				</div>
			</div>
		</div>
	}
	@if (ShowSettingsDialog)
	{
		<div class="settings-background">
			<div class="settings-dialog visible">
				<div class="settings-content">
					<h2 class="title">Settings</h2>
					<ul class="settings-tabs">
						<li class="settings-tab" @onclick="@(() => @SelectTab(PanelType.General))">General</li>
						<li class="settings-tab" @onclick="@(() => @SelectTab(PanelType.Player))">Player</li>
						<li class="settings-tab" @onclick="@(() => @SelectTab(PanelType.Audio))">Audio</li>
						<li class="settings-tab" @onclick="@(() => @SelectTab(PanelType.Misc))">Misc</li>
					</ul>
					<div class="settings-tab-content">
						@if (selectedTab == PanelType.General)
						{
							<div class="settings-tab-box">
								
								
								<button @onclick="@(() => @DecreaseSensitivity(0.1))">-0.1</button>
								<button @onclick="@(() => @DecreaseSensitivity(1.0))">-1</button>
								<label for="mouseSensitivity">Sensitivity:</label>
								<p class="e">@mouseSensitivityInput.ToString("F1")</p>
								<button @onclick="@(() => @IncreaseSensitivity(1.0))">+1</button>
								<button @onclick="@(() => @IncreaseSensitivity(0.1))">+0.1</button>
								
							</div>
						}
						else if (selectedTab == PanelType.Player)
						{
							<div class="tab-panel">Player Settings Content</div>
						}
						else if (selectedTab == PanelType.Audio)
						{
							<div class="tab-panel">Audio Settings Content</div>
						}
						else if (selectedTab == PanelType.Misc)
						{
							<div class="tab-panel">Misc Settings Content</div>
						}
					</div>
					<button class="settings-button" @onclick="@CloseSettingsDialog">Close</button>
					<button class="settings-button" @onclick="@SaveSettings">Save</button>
				</div>
			</div>
		</div>
	}


		
		
		
	
	
	
</root>
