@inherits PanelComponent
@namespace GeneralGame.HUD

<root>
	<div class="pause-menu @(PausePanelEnabled ? "enabled" : "disabled")">
		<div class="pause-menu-content @(PausePanelEnabled ? "enabled" : "disabled")">
			<div class="boy">
				<div class="pause-menu-pic"></div>
				<div class="pause-menu-title">Pause Menu</div>
				
				<div class="pause-menu-buttons">
					<button class="pause-menu-button" @onclick="@ExitGame">Resume</button>
					<div class="pause-menu-button" @onclick="@(() => @Game.Overlay.ShowBinds())">Controls</div>
					<button class="pause-menu-button" @onclick="@(() => @Game.Overlay.ShowSettingsModal())">Settings</button>
					<button class="pause-menu-button" @onclick="@Abondon">Back to Lobby</button>
					<button class="pause-menu-button" @onclick="@Quit">Exit</button>
					

				</div>


			</div>
			
			
		</div>
		<div class="pause-menu-content2 @(PausePanelEnabled ? "enabled" : "disabled")">
			<div class="boy2">
				<div class="discord">
					
						<div class="discord-title">Discord</div>
						<div class="discord-title2"></div>
						<div class="discord-buttons">
						<button class="discord-button" >Join</button>
						<button class="discord-button" >Discord link:</button>
						</div>
				</div>

			</div>
		</div>
	</div>
	@if (ShowConfirmationDialog)
	{
		<div class="confirmation-dialog">
			<div class="confirmation-content">
				<p>Sind Sie sicher, dass Sie das Spiel beenden möchten?</p>
				<button class="confirmation-button" @onclick="@ConfirmQuit">Exit</button>
				<button class="confirmation-button" @onclick="@CancelQuit">Nein</button>
			</div>
		</div>
	}

		



		
		
		
	
	
	
</root>
