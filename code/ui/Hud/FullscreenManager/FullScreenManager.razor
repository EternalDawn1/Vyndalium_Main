@using Sandbox;
@using Sandbox.UI;
@using GeneralGame.HUD
@using GeneralGame
@inherits Panel
@namespace GeneralGame.HUD


<root>
    <div class="panel-container">
        @switch (ActivePanel)
        {
            case FullScreenPanel.InGameHud:
                <div class="panel fade-in">
                    <InGameHud />
                </div>
                break;
            case FullScreenPanel.CharacterMenu:
                <div class="panel fade-in">
                    <CharacterMenu />
                </div>
                break;
            case FullScreenPanel.Inventory:
                <div class="panel fade-in">
                    <Inventory />
                </div>
                break;
            case FullScreenPanel.Abilities:
                <div class="panel fade-in">
                    <Abilities />
                </div>
                break;
            case FullScreenPanel.Confirm:
                <div class="panel fade-in">
                    <Confirm />
                </div>
                break;
            case FullScreenPanel.StorageBox:
                <div class="panel fade-in">
                    <StorageBox />
                </div>
                break;
            case FullScreenPanel.ShopPanel:
                <div class="panel fade-in">
                    <ShopPanel />
                </div>
                break;
            case FullScreenPanel.Leaderboard:
                <div class="panel fade-in">
                    <Leaderboard />
                </div>
                break;
            case FullScreenPanel.MissonPanel:
                <div class="panel fade-in">
                    <Lobby />
                </div>
                break;
            default:
                throw new ArgumentOutOfRangeException();
        }

        @if (PreviousPanel != FullScreenPanel.InGameHud && IsTransitioning)
        {
            <div class="panel fade-out">
                @RenderPreviousPanel()
            </div>
        }
    </div>
</root>

@code
{
    public static FullScreenManager Instance { get; private set; }

    public enum FullScreenPanel
    {
        InGameHud,
        CharacterMenu,
        Abilities,
        Inventory,
        PauseMenu,
        Confirm,
        StorageBox,
        ShopPanel,
        Leaderboard,
        MissonPanel,

        Quests
        
    }

    public FullScreenPanel ActivePanel { get; private set; } = FullScreenPanel.InGameHud;
    public FullScreenPanel PreviousPanel { get; private set; } = FullScreenPanel.InGameHud;
    
    public bool IsTransitioning { get; private set; } = false;
    private TimeSince TimeSinceTransition { get; set; } = 0f;
    private const float TransitionDuration = 0.5f;

    public FullScreenManager()
    {
        Instance = this;
    }

    public void Display(FullScreenPanel panel)
    {
        if (InGameHud.Instance?.ShowReturnToLobby == true)
        {
            return;
        }

        // Falls wir bereits im Übergang sind, breche ab
        if (IsTransitioning && TimeSinceTransition < TransitionDuration)
            return;

        PreviousPanel = ActivePanel;
        ActivePanel = panel;

        // Starte den Übergang
        IsTransitioning = true;
        TimeSinceTransition = 0;
    }
    public void ClosePanel()
    {
        ActivePanel = FullScreenPanel.InGameHud;
    }

    public override void Tick()
    {
        if (InGameHud.Instance?.ShowReturnToLobby == true)
        {
            return;
        }
        if (IsTransitioning && TimeSinceTransition > TransitionDuration)
        {
            IsTransitioning = false;
        }
        
    if ( Input.EscapePressed )// Stellen Sie sicher, dass "Input" korrekt referenziert wird.
    {
         Input.EscapePressed = false;
        if (ActivePanel == FullScreenPanel.Inventory)
        {
            Display(FullScreenPanel.InGameHud);
        }
        else if (ActivePanel == FullScreenPanel.InGameHud)
        {
            Toggle(FullScreenPanel.PauseMenu);
        }
        else if (ActivePanel == FullScreenPanel.StorageBox)
        {
            Toggle(FullScreenPanel.InGameHud);
        }
        else
        {
            Toggle(FullScreenPanel.InGameHud);
        }
    }

    if (Input.Pressed(InputAction.Inventory))
    {
        if (ActivePanel == FullScreenPanel.Inventory)
        {
            ActivePanel = FullScreenPanel.InGameHud;
        }
        else
        {
            ActivePanel = FullScreenPanel.Inventory;
        }
    }

    if (Input.Pressed(InputAction.Abilities))
    {
        if (ActivePanel == FullScreenPanel.Abilities)
        {
            ActivePanel = FullScreenPanel.InGameHud;
        }
        else
        {
            ActivePanel = FullScreenPanel.Abilities;
        }
    }
}

    private void Toggle(FullScreenPanel panel)
    {
        if (ActivePanel == panel)
        {
            Display(FullScreenPanel.InGameHud);
        }
        else if (ActivePanel == FullScreenPanel.PauseMenu)
        {
            Input.EscapePressed = false;
        }
        else
        {
            Display(panel);
        }

        if (Player.Local != null)
        {
            Player.Local.BlockInputs = false;
        }
    }
    private RenderFragment RenderPreviousPanel() => builder =>
    {
        switch (PreviousPanel)
        {
            case FullScreenPanel.InGameHud:
                builder.OpenComponent<InGameHud>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.CharacterMenu:
                builder.OpenComponent<CharacterMenu>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.Inventory:
                builder.OpenComponent<Inventory>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.Abilities:
                builder.OpenComponent<Abilities>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.Confirm:
                builder.OpenComponent<Confirm>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.StorageBox:
                builder.OpenComponent<StorageBox>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.ShopPanel:
                builder.OpenComponent<ShopPanel>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.Leaderboard:
                builder.OpenComponent<Leaderboard>(0);
                builder.CloseComponent();
                break;
            case FullScreenPanel.MissonPanel:
                builder.OpenComponent<Lobby>(0);
                builder.CloseComponent();
                break;
        }
    };

    // Hilfsmethode zur Bestimmung des Komponententyps
    private Type GetPanelType(FullScreenPanel panel)
    {
        return panel switch
        {
            FullScreenPanel.InGameHud => typeof(InGameHud),
            FullScreenPanel.CharacterMenu => typeof(CharacterMenu),
            FullScreenPanel.Inventory => typeof(Inventory),
            FullScreenPanel.Abilities => typeof(Abilities),
            FullScreenPanel.Confirm => typeof(Confirm),
            FullScreenPanel.StorageBox => typeof(StorageBox),
            FullScreenPanel.ShopPanel => typeof(ShopPanel),
            FullScreenPanel.Leaderboard => typeof(Leaderboard),
            FullScreenPanel.MissonPanel => typeof(Lobby),
            _ => typeof(InGameHud)
        };
    }

    public static bool Is(FullScreenPanel mode)
		=> FullScreenManager.Instance?.ActivePanel == mode;

    protected override int BuildHash()
    => HashCode.Combine(ActivePanel.GetHashCode(), IsTransitioning, TimeSinceTransition);
}
