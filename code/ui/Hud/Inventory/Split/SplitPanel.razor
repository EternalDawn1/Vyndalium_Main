@namespace GeneralGame.HUD
@attribute [StyleSheet]
@inherits Panel
@using GeneralGame

<root>
    <div class="top-top">
        <div class="top-name">Split Items</div>
        <div class="count">Count: @_item.Count / Max Stack: @_item.MaxStack</div>
        <div class="number">
            <input type="range" @bind="splitAmount" min="1" max="@(_item.Count - 1)" />
            <span>@splitAmount</span>
        </div>
        <button class="button" @onclick="@Split">Split</button>
        <button class="button" @onclick="@Close">Cancel</button>
    </div>
</root>

@code {
    private static SplitPanel _instance;
    private ItemComponent _item;
    private int splitAmount = 1;

    public static void Open(ItemComponent item)
    {
        Close();
        _instance = new();
        _instance._item = item;
        Hudmaster.Instance.Panel.AddChild(_instance);
    }

    public static void Close()
    {
        _instance?.Delete();
        _instance = null;
        Log.Info("SplitPanel Closed");
    }

    private void Split()
    {
        if (splitAmount > 0 && splitAmount < _item.Count)
        {
            var newItem = _item.Split(splitAmount);
            Player.Local.Inventory.GiveBackpackItem(newItem, Player.Local.Inventory.GetFirstFreeBackpackSlot());
            Inventory.Instance?.OnChanged();
            Close();
        }
    }
}