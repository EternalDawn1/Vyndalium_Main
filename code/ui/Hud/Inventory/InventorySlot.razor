@namespace GeneralGame.HUD
@attribute [StyleSheet]
@inherits Panel
@using System
@using Sandbox.UI
@using System.Linq
@using Sandbox



<root @onrightclick=@( () => @OpenContextMenu() ) class="@CurrentDropTargetClassSelectors">
	
    <div class="border" />
    <div class="@($"background {@GetBackgroundClass()}")" style="@($"opacity: {GetOpacityBasedOnLevel()}")" />
    @if (Item is not null)
    {
		
        <div class="item @HasChildDraggableClassSelector" onmouseover=@( () => OnItemHover() ) onmouseout=@( () => OnItemHoverExit() ) )>
            @if (Item.IconTexture is not null)
            {
                <div class="item-forground"><img src=@Item.IconTexture.ResourcePath @onmouseover="@OnItemHover" @onmouseout="@OnItemHoverExit" /></div>
				
            }
			
            <text class="count @( !Item.IsStackable ? "hidden" : "" )">@(Item.Count)x</text>
            @if (Item.IsFavorite)
            {
                <img src="ui/hud/star.gif" alt="Favorite" class="favorite-icon" />
            }
			@if (IsSelected)
			{
				<div class="select"><img src="ui/hud/success.gif" alt="Selected" class="selected-icon" /></div>
			}
			@if (Item.Aspect != AspectType.None)
				{
					<div class="aspect-icon"><img src=@Item.GetAspectIcon() alt="Aspect" /></div>
				}
			

        </div>
    }
    @if (EquipSlotIndex is not null)
    {
        <img class="slot" src=@EquipSlotIndex?.GetIcon() />
    }
	
</root>

@code {
	public bool IsSelected { get; set; } = false;
	public bool IsProxy { get; set; } = false;
	public void ToggleSelection()
{
    IsSelected = !IsSelected;
    if (IsSelected)
    {
        ShopPanel.Instance.selectedItems.Add(Item);
        if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.StorageBox)
        {
            StorageBox.Instance.selectedItems.Add(Item);
        }
    }
    else
    {
        ShopPanel.Instance.selectedItems.Remove(Item);
        if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.StorageBox)
        {
            StorageBox.Instance.selectedItems.Remove(Item);
        }
    }
    StateHasChanged();
}
	
	public enum SlotType
	{
		Backpack,
		Chest,

		// Weitere Typen nach Bedarf
	}
	public SlotType Type { get; set; } = SlotType.Backpack;
	
	

	private string GetBackgroundClass()
	{
		if (Item is null)
			return "background-tier-c"; // Standardhintergrund, wenn kein Item vorhanden ist

		return Item.Tier switch
		{
			GeneralGame.Tier.C => "background-tier-c",
			GeneralGame.Tier.B => "background-tier-b",
			GeneralGame.Tier.A => "background-tier-a",
			GeneralGame.Tier.S => "background-tier-s",
			GeneralGame.Tier.SS => "background-tier-ss",
			GeneralGame.Tier.SSS => "background-tier-sss",
			GeneralGame.Tier.Ultimate => "background-tier-ultimate",
			_ => "background-tier-c", // Standardfall, falls keine Übereinstimmung gefunden wird
		};
	}
	public enum ItemTier
	{
		C,
		B,
		A,
		S,
		SS,
		SSS,
		Ultimate,
		// Fügen Sie weitere Stufen hinzu, falls notwendig
	}
	private GeneralGame.Tier ConvertToGeneralGameTier(ItemTier itemTier)
	{
		return itemTier switch
		{
			ItemTier.C => GeneralGame.Tier.C,
			ItemTier.B => GeneralGame.Tier.B,
			ItemTier.A => GeneralGame.Tier.A,
			ItemTier.S => GeneralGame.Tier.S,
			ItemTier.SS => GeneralGame.Tier.SS,
			ItemTier.SSS => GeneralGame.Tier.SSS,
			ItemTier.Ultimate => GeneralGame.Tier.Ultimate,
			_ => throw new ArgumentOutOfRangeException(nameof(itemTier), $"Nicht unterstützter ItemTier: {itemTier}")
		};
	}
	public float GetOpacityBasedOnLevel()
	{
		if (Item == null  )
		{
			// Standard-Opazität zurückgeben, wenn 'Item' null ist
			return 1.0f; // oder einen anderen Standardwert
		}
		if (Item.Tier == GeneralGame.Tier.Ultimate)
		{
			// Rückgabe einer festen Deckkraft für Ultimate-Tier
			return 1.0f;
		}
		
		// Stellen Sie sicher, dass Item.Level zwischen 0 und 27 liegt
		float clampedLevel = Math.Clamp(Item.ItemLevel, 0, 27);
		// Berechnen Sie die Deckkraft basierend auf den Level-Schritten
		float opacity;
		if (clampedLevel == 27)
		{
			// Stellen Sie sicher, dass die Deckkraft bei Level 27 genau 1.0 ist
			opacity = 1.0f;
		}
		else
		{
			// Erhöhen Sie die Deckkraft alle 5 Levels um 0.2, beginnend mit 0.1 bei Level 0
			opacity = 0.1f + ((int)(clampedLevel / 5) * 0.2f);
		}
		return opacity;
	}

	public ItemComponent Item { get; set; }

	public EquipSlot? EquipSlotIndex { get; set; } = null;

	public int? BackpackSlotIndex { get; set; } = null;
	public int? UpgradeSlotIndex { get; set; } = null;

	public int? IndependentSlotIndex { get; set; } = null;

	public int? StorageSlotIndex { get; set; } = null;
	public int? ShopSlotIndex { get; set; } = null;
	public int? AspectSlotIndex { get; set; } = null;
	public bool IsChestSlot { get; set; } = false;
	public int? BackpackPackSlotIndex { get; set; } = null;

	//TODO: Add a way to set the slot index from the outside

	bool isMouseDown = false;



	// Child draggable

	private DraggableItem ChildDraggable { get; set; }

	private string HasChildDraggableClassSelector => ChildDraggable == null ? "" : "has-child-draggable";

	private TimeUntil _childDraggableTrashTimer;

	private TimeUntil _childDraggableTrashAnimationTimer;

	private const float TimeUntilChildDraggableCanBeTrashed = 0.05f;

	private const float TimeUntilChildDraggableCanBeTrashedAnimation = 0.33f;



	// Current active draggable (available from anywhere)

	public static DraggableItem CurrentDraggable { get; private set; }



	private Vector2 _lastMousePos;

	private bool _isHoveringItem { get; set; } = false;

	private RealTimeSince sinceClick;



	public InventorySlot()

	{

		// Add random transition delay

		Style.Transitions = new TransitionList();



		Style.Transitions.List.Add(new TransitionDesc

			{

				TimingFunction = "bounce",

				Property = "transform",

				Duration = 200,

			});



		Style.Transitions.List.Add(new TransitionDesc

			{

				TimingFunction = "ease",

				Property = "opacity",

				Duration = 250,

				Delay = Random.Shared.NextSingle() * 100

			});

	}



	// is-drop-target,

	// can-drop: if the draggable is usable in this slot,

	private string CurrentDropTargetClassSelectors

	{

		get

		{

			if (CurrentDraggable == null)

				return "";



			var s = "";



			if (IsHoveredByMouse())

				s += "is-drop-target ";



			if (CanDraggableDrop())

				s += "can-drop ";



			return s;

		}

	}



	protected override int BuildHash() => HashCode.Combine(Item?.GetHashCode(), Item?.Count,Item?.IsFavorite, IsHoveredByMouse(), CurrentDraggable);



	// Can the draggable (DraggableItem.Current) drop here?

	private bool CanDraggableDrop()

	{

		if (CurrentDraggable == null)

			return false; // No draggable



		if (BackpackSlotIndex != null)

			return true; // Backpack slots allow everything!

		if(IndependentSlotIndex != null)
		{
			return false;
		}
		if (StorageSlotIndex != null)

			return true; // Storage slots allow everything!
		if (StorageSlotIndex != null)

			return true;
		if (AspectSlotIndex != null)

			return true;

		if (EquipSlotIndex != null)
		{
			return true;
		}

		if (BackpackPackSlotIndex != null)
		{
			return true;
		}
		{

			if (CurrentDraggable.ItemComponent is not ItemEquipment itemEquipment)

				return false; // Can't drop into this equipment slot, the item isn't equipment!



			return itemEquipment.Slot == EquipSlotIndex;

		}



		return false;

	}


	
	private void OpenContextMenu()

	{

		if (Item is not null)

			ContextMenu.Open(Item);

	}




	private async void OnItemHover()

	{

		_isHoveringItem = true;



		await GameTask.Delay(0);



		if (_isHoveringItem && !ContextMenu.IsOpen() && Item is not null)

			HoverPanel.Open(Item);

	}



	private void OnItemHoverExit()

	{

		_isHoveringItem = false;

		HoverPanel.Close();

	}



	/// Update the ItemComponent instance from the Slot / SlotIndex properties

	public void UpdateItem()

	{

		Inventory.Instance?.OnChanged();

		var inventory = Player.Local.Inventory;
		

		if (EquipSlotIndex != null)

		{

			Item = inventory.EquippedItems[(int)EquipSlotIndex];

			StateHasChanged();

			return;

		}



		if (BackpackSlotIndex != null)

		{

			Item = inventory.BackpackItems[(int)BackpackSlotIndex];

			StateHasChanged();

			return;

		}
		
		if (IndependentSlotIndex != null)
		{
			Item = inventory.BackpackItems[(int)IndependentSlotIndex];
			StateHasChanged();
			return;
		}
		if (StorageSlotIndex != null)

		{

			Item = inventory.StorageItems[(int)StorageSlotIndex];

			StateHasChanged();

			return;

		}
		if (StorageSlotIndex != null)

		{

			Item = inventory.StorageItems[(int)StorageSlotIndex];

			StateHasChanged();

			return;

		}
		if(AspectSlotIndex != null)
		{
			Item = inventory.AspectItems[(int)AspectSlotIndex];
			StateHasChanged();
			return;
		}
		if (BackpackPackSlotIndex != null)
		{
			Item = inventory.BackpackBagItems[(int)BackpackPackSlotIndex];
			StateHasChanged();
			return;
		}



		StateHasChanged();

		throw new Exception("EquipSlotIndex or BackpackSlotIndex needs to be provided to InventorySlot!");

	}


	private int currentPage = 0;


	public bool IsHoveredByMouse() => Box.Rect.IsInside(Mouse.Position);
	private void MoveItemToStorage(ItemComponent item)
	{
		// Verwenden Sie die Methode aus dem Inventar
		Player.Local.Inventory.MoveItemToStorage(item, currentPage);
	}
	private void MoveItemToBackpack(ItemComponent item)
	{
		// Verwenden Sie die Methode aus dem Inventar
		Player.Local.Inventory.MoveItemToBackpack(item);
	}

	
	

	
	protected override void OnMouseDown(MousePanelEvent e)
{
    base.OnMouseDown(e);

    if (ShopSlotIndex != null)
    {
        // Drag-and-Drop für Shop-Slots deaktivieren
        return;
    }
    if (UpgradeSlotIndex != null)
    {
        // Drag-and-Drop für Upgrade-Slots deaktivieren
        return;
    }
    if (IndependentSlotIndex != null)
    {
        if (sinceClick < 0.4f)
        {
            AddItemToPlayerInventory(Item);
            PlaySound("drop");
            Inventory.Instance.OnChanged();
            sinceClick = 0;
            return;
        }
    }

    if (BackpackSlotIndex != null && FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel
    &&
    ShopPanel.Instance.currentPanel == ShopPanel.PanelType.Inventory)
    {
        if (Item == null)
            return;
        if (e.Button != "mouseleft")
            return;
        ToggleSelection();

        return;
    }
	if(IndependentSlotIndex != null && FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.StorageBox)
	{
		
        if (Item == null)
            return;
        if (e.Button != "mouseleft")
            return;
        ToggleSelection();

        return;
    
	}

    if (BackpackSlotIndex != null && FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel
    &&
    ShopPanel.Instance.currentPanel == ShopPanel.PanelType.Inventory)
        return;
    if ( FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel
    &&
    ShopPanel.Instance.currentPanel == ShopPanel.PanelType.Weapons)
        return;

    if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel
    &&
    ShopPanel.Instance.currentPanel == ShopPanel.PanelType.Armor)
        return;

    if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel
    &&
    ShopPanel.Instance.currentPanel == ShopPanel.PanelType.StoreItems)
        return;

    if (e.Button != "mouseleft")
        return;
	if (Item == null)
            return;

    if (sinceClick < 0.4f && Item is ItemEquipment equipment)
    {
        if (equipment.IsWeapon || equipment.IsArmor)
        {
            if (equipment.Equipped)
                Player.Local.Inventory.UnequipItem(equipment);
            else
                Player.Local.Inventory.EquipItemFromBackpack(equipment);

            PlaySound("drop");
            Inventory.Instance.OnChanged();
            sinceClick = 0;
            return;
        }
    }

    isMouseDown = true;
    sinceClick = 0;
    OnDragStart();

    if (ChildDraggable != null)
        return;

    if (Item == null)
        return; 

    if (Player.Local == null)
    {
        Log.Error("Player.Local ist null.");
        return;
    }

    if (Player.Local.Inventory == null)
    {
        Log.Error("Player.Local.Inventory ist null.");
        return;
    }

    ChildDraggable = new DraggableItem(this, holdPoint: Mouse.Position - Box.Rect.TopLeft);
    ChildDraggable.SetPositionInScreenPixels(Mouse.Position);

    var fraction = (Mouse.Position - Box.Rect.Size / 2f) / Screen.Size;
    ChildDraggable.Style.Left = Length.Fraction(fraction.x);
    ChildDraggable.Style.Top = Length.Fraction(fraction.y);

    Hudmaster.Instance.Panel.AddChild(ChildDraggable);
    CurrentDraggable = ChildDraggable;
}

	private void MoveItemTo(InventorySlot targetSlot)
	{
		var fromSlot = this;
		var inventory = Player.Local.Inventory;

		// From storage slot.
		
		// From backpack slot.
		if (fromSlot.BackpackSlotIndex is not null)
		{
			// To backpack slot.
			if (targetSlot.BackpackSlotIndex is not null)
			{
				var res = inventory.SwapItems(fromSlot.BackpackSlotIndex.Value, targetSlot.BackpackSlotIndex.Value);
				PlaySound(res ? "drop" : "serror");
			}
			else if (fromSlot.StorageSlotIndex is not null)
			{
				// To backpack slot.
				if (targetSlot.BackpackSlotIndex is not null)
				{
					var itemComponent = inventory.StorageItems[fromSlot.StorageSlotIndex.Value];
					inventory.MoveItemToBackpack(itemComponent, targetSlot.BackpackSlotIndex.Value);
					inventory.RemoveStorageItem(itemComponent, fromSlot.StorageSlotIndex.Value);

					PlaySound("drop");
				}
			}
			
			// To backpack pack slot.
			else if (targetSlot.BackpackPackSlotIndex is not null)
			{
				var itemComponent = inventory.BackpackItems[fromSlot.BackpackSlotIndex.Value];
				int targetBackpackPackSlotIndex = targetSlot.BackpackPackSlotIndex.Value;

				// Überprüfen, ob das Ziel-Slot bereits ein Item enthält
				if (inventory.BackpackBagItems[targetBackpackPackSlotIndex] != null)
				{
					// Swappen der Items
					var res = inventory.SwapBackpackPackItems(fromSlot.BackpackSlotIndex.Value, targetBackpackPackSlotIndex);
					PlaySound(res ? "drop" : "serror");
				}
				else
				{
					// Hinzufügen des Items zum Ziel-Slot
					bool res = inventory.MoveItemToBackpackPackSlot(itemComponent, targetBackpackPackSlotIndex);
					if (res)
					{
						// Entferne das Item aus dem ursprünglichen Slot
						inventory.RemoveBackpackItem(itemComponent, fromSlot.BackpackSlotIndex.Value);
					}
					PlaySound(res ? "drop" : "serror");
				}
			}
		}
		else if (fromSlot.StorageSlotIndex is not null)
		{
			// To backpack slot.
			if (targetSlot.BackpackSlotIndex is not null)
			{
				var itemComponent = inventory.StorageItems[fromSlot.StorageSlotIndex.Value];
				inventory.MoveItemToBackpack(itemComponent, targetSlot.BackpackSlotIndex.Value);
				inventory.RemoveStorageItem(itemComponent, fromSlot.StorageSlotIndex.Value);
				
				PlaySound("drop");
			}
		}
		
		else if (fromSlot.EquipSlotIndex is not null)
		{
			// To backpack slot.
			if (targetSlot.BackpackSlotIndex is not null)
			{
				var res = inventory.SwapItems(fromSlot.EquipSlotIndex.Value, targetSlot.BackpackSlotIndex.Value );
				PlaySound(res ? "drop" : "serror");
			}
			// To equip slot.
			else if (targetSlot.EquipSlotIndex is not null)
			{
				var res = inventory.SwapItems(fromSlot.EquipSlotIndex.Value, (int)targetSlot.EquipSlotIndex.Value);
				PlaySound(res ? "drop" : "serror");
			}
		}
		
		
		
		else if (fromSlot.BackpackPackSlotIndex is not null)
		{
			// To backpack slot.
			if (targetSlot.BackpackSlotIndex is not null)
			{
				var itemComponent = inventory.BackpackBagItems[fromSlot.BackpackPackSlotIndex.Value];
				int targetBackpackSlotIndex = targetSlot.BackpackSlotIndex.Value;

				// Überprüfen, ob das Ziel-Slot bereits ein Item enthält
				if (inventory.BackpackItems[targetBackpackSlotIndex] != null)
				{
					// Swappen der Items
					var res = inventory.SwapBackpackPackItems(fromSlot.BackpackPackSlotIndex.Value, targetBackpackSlotIndex);
					PlaySound(res ? "drop" : "serror");
				}
				else
				{
					// Hinzufügen des Items zum Ziel-Slot
					bool res = inventory.MoveItemToBackpackSlot(itemComponent, targetBackpackSlotIndex);
					if (res)
					{
						// Entferne das Item aus dem ursprünglichen Slot
						inventory.RemoveBackpackPackItem(itemComponent, fromSlot.BackpackPackSlotIndex.Value);
					}
					PlaySound(res ? "drop" : "serror");
				}
			}
			// To another backpack pack slot.
			else if (targetSlot.BackpackPackSlotIndex is not null)
			{
				var itemComponent = inventory.BackpackBagItems[fromSlot.BackpackPackSlotIndex.Value];
				int targetBackpackPackSlotIndex = targetSlot.BackpackPackSlotIndex.Value;

				// Überprüfen, ob das Ziel-Slot bereits ein Item enthält
				if (inventory.BackpackBagItems[targetBackpackPackSlotIndex] != null)
				{
					// Swappen der Items
					var res = inventory.SwapBackpackPackItems(fromSlot.BackpackPackSlotIndex.Value, targetBackpackPackSlotIndex);
					PlaySound(res ? "drop" : "serror");
				}
				else
				{
					// Hinzufügen des Items zum Ziel-Slot
					bool res = inventory.MoveItemToBackpackPackSlot(itemComponent, targetBackpackPackSlotIndex);
					if (res)
					{
						// Entferne das Item aus dem ursprünglichen Slot
						inventory.RemoveBackpackPackItem(itemComponent, fromSlot.BackpackPackSlotIndex.Value);
					}
					PlaySound(res ? "drop" : "serror");
				}
			}
		}
		

		// Update both slots
		fromSlot.UpdateItem();
		targetSlot.UpdateItem();
	}
	

	private void MoveOntoCharacter()

	{

		var fromSlot = this;

		var inventory = Player.Local.Inventory;



		if (fromSlot.Item is ItemEquipment equipment)

			if (inventory.EquipItemFromBackpack(equipment))

				PlaySound("drop");



		fromSlot.UpdateItem();

	}
	



	protected override void OnMouseUp(MousePanelEvent e)

	{

		base.OnMouseUp(e);
		


		if (ChildDraggable == null)

			return;



		if ( ChildDraggable.HasClass( "can-drop" ) )

		{

			if (ChildDraggable.HasClass("is-hovering-slot"))

			{

				if (ChildDraggable.LastHoveredSlot != this)

					MoveItemTo(ChildDraggable.LastHoveredSlot);

			}

			else if (ChildDraggable.HasClass("is-hovering-character"))

			{

				MoveOntoCharacter();

			}

			else if (_childDraggableTrashTimer)

			{

				// Not hovering anything, drop the item!

				Player.Local.Inventory.DropItem(ChildDraggable.ItemComponent);
				

				Inventory.Instance?.OnChanged();

				PlaySound("drop");

			}

		}

		if (e.MouseButton == MouseButtons.Left)

		{

			isMouseDown = false;

		}



		if (sinceClick < 0.4f)
		{
			ChildDraggable?.Delete();
			ChildDraggable = null;
			CurrentDraggable = null;
		}
		else
		{
			ChildDraggable?.Delete();
			ChildDraggable = null;
			CurrentDraggable = null;
		}

	}


	private void UpdateChildDraggableState()
	{
		if (ChildDraggable == null)
			return;

		if (IndependentSlotIndex != null)
		return;

		ChildDraggable.RemoveClass("is-hovering-slot");
		ChildDraggable.RemoveClass("is-hovering-character");
		ChildDraggable.RemoveClass("should-trash");
		ChildDraggable.RemoveClass("can-drop");

		// Ensure Inventory.Instance is not null
		if (Inventory.Instance == null)
			return;

		// Check for what's under the ChildDraggable
		var rendererTarget = Inventory.Instance.Descendants?.OfType<CharacterRenderer>()?.FirstOrDefault(v =>
		v?.IsHoveredByMouse() == true);
		var targetSlot = Inventory.Instance.Descendants?.OfType<InventorySlot>()?.FirstOrDefault(v => v?.IsHoveredByMouse() ==
		true);

		if (targetSlot != null)
		{
			ChildDraggable.SetClass("is-hovering-slot", true);
			ChildDraggable.LastHoveredSlot = targetSlot;
			_childDraggableTrashAnimationTimer = TimeUntilChildDraggableCanBeTrashedAnimation;
			_childDraggableTrashTimer = TimeUntilChildDraggableCanBeTrashed;

			// Check if the target slot is not an IndependentSlotIndex
			if (targetSlot.IndependentSlotIndex == null)
			{
				ChildDraggable.SetClass("can-drop", true);
			}
		}
		else
		{
			if (_childDraggableTrashAnimationTimer)
				ChildDraggable.SetClass("should-trash", true);

			// Check if the current slot is not an IndependentSlotIndex
			if (IndependentSlotIndex == null)
			{
				ChildDraggable.SetClass("can-drop", true);
			}
		}
		ChildDraggable.StateHasChanged();
	}

	protected override void OnMouseMove(MousePanelEvent e)
	{
		base.OnMouseMove(e);

		if (ChildDraggable == null)
			return;
		
		

		// Mouse.Delta returns 0,0 for small values?
		// Make our own delta!
		var delta = Mouse.Position - (_lastMousePos == -0 ? Mouse.Position : _lastMousePos);
		_lastMousePos = Mouse.Position;

		// Ensure ChildDraggable is not null before using it
		if (ChildDraggable != null)
		{
			ChildDraggable.AddPositionDeltaInScreenPixels(delta);
			ChildDraggable.SetPositionInScreenPixels(Mouse.Position);
		}

		UpdateChildDraggableState();

		if (isMouseDown)
		{
			e.StopPropagation();
		}
	}

	private void OnDragStart()
	{
		if (ChildDraggable != null)
			return;
		if (Item == null)
			return; // Ignore itemless slot

		if (IndependentSlotIndex != null)
			return;

			
		ChildDraggable = new DraggableItem(this, holdPoint: Mouse.Position - Box.Rect.TopLeft);
		ChildDraggable.SetPositionInScreenPixels(Mouse.Position);
		var fraction = (Mouse.Position - Box.Rect.Size / 2f) / Screen.Size;
		ChildDraggable.Style.Left = Length.Fraction(fraction.x);
		ChildDraggable.Style.Top = Length.Fraction(fraction.y);
		Hudmaster.Instance.Panel.AddChild(ChildDraggable);
		CurrentDraggable = ChildDraggable;
	}

	public override void Tick()

	{

		base.Tick();



		if (_childDraggableTrashTimer)

			UpdateChildDraggableState();

	}

	///
	/// Add the item to the player's inventory
	///
	private void AddItemToPlayerInventory(ItemComponent item)
	{
		if (item == null) return;

		var player = Player.Local;
		if (player == null)
		{
			Log.Error("Player.Local ist null.");
			return;
		}

		var inventory = player.Inventory;
		if (inventory == null)
		{
			Log.Error("Player.Inventory ist null.");
			return;
		}

		var firstFreeSlot = inventory._backpackItems.IndexOf(null);

		// Überprüfen Sie, ob das Item bereits im Inventar ist
		if (inventory._backpackItems.Contains(item))
		{
			Log.Info($"Item {item.Name} ist bereits im Inventar.");
			return;
		}

		// Überprüfen Sie, ob ein freier Slot verfügbar ist
		if (firstFreeSlot != -1)
		{
			// Fügen Sie das Item in den ersten freien Slot ein
			inventory._backpackItems[firstFreeSlot] = item;
			item.State = ItemState.Backpack;

			// Entfernen Sie das Item aus der StorageBox
			var storageBox = StorageBox.Instance?.itemStorage;
			if (storageBox != null && storageBox.Items.Contains(item))
			{
				storageBox.Items.Remove(item);
			}
			Player.Save();
			Inventory.Instance?.OnChanged();
			Hudmaster.Instance.ShowNotification($"received {item.Name}", "/ui/hud/hand_slot.png");

			// Fügen Sie diesen Aufruf hinzu, um die Komponente neu zu rendern
			StateHasChanged();

			// Schließen Sie das Item-Informationsfenster
			HoverPanel.Close();
		}
		else
		{
			Log.Error("Kein freier Slot im Rucksack verfügbar.");
		}
	}



}
