@inherits Panel
@namespace GeneralGame.HUD
@attribute [StyleSheet]

<root class="inventory-panel">
    <SideButton OnClick=@(() =>
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud)) IsInverted=@(true)
        ImagePath="ui/hud/exit.gif" style="position: absolute; top: 30px; right: 0px; z-index: 100;" />
    
   
    <div class="inventory-list" CanDragScroll="false" >
        @switch (ActivePanel)
        {
            case PanelType.Inventory:
                <div class="inventory-content">
                    <!-- LEFT PANEL: Character & Equipment -->
                    <div class="character-panel">
                        <div class="character-viewport">
                            <CharacterRenderer @ref=_renderer />
                        </div>
                        
                        <div class="equipment-section">
                            <div class="section-header">Ausrüstung</div>
                            
                            <!-- Head & Face Row -->
                            <div class="equipment-row">
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Kopf</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Head 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Head] />
                                </div>
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Gesicht</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Face 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Face] />
                                </div>
                            </div>

                            <!-- Body & Arms Row -->
                            <div class="equipment-row">
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Körper</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Body 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Body] />
                                </div>
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Hände</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Hand 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Hand] />
                                </div>
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Spange</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Bracer 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Bracer] />
                                </div>
                            </div>

                            <!-- Legs & Feet Row -->
                            <div class="equipment-row">
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Beine</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Legs 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Legs] />
                                </div>
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Füße</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Feet 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Feet] />
                                </div>
                                <div class="equipment-slot-wrapper">
                                    <label class="slot-label">Gürtel</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Belt 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Belt] />
                                </div>
                            </div>

                            <!-- Back/Cape Row -->
                            <div class="equipment-row">
                                <div class="equipment-slot-wrapper full-width">
                                    <label class="slot-label">Rücken</label>
                                    <InventorySlot EquipSlotIndex=@EquipSlot.Back 
                                                class="slot equipment-slot"
                                                Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Back] />
                                </div>
                            </div>
                        </div>

                        <!-- Player Info Card -->
                        <div class="player-info-card">
                            <div class="player-stat">
                                <span class="stat-label">Vyndalium</span>
                                <span class="stat-value">@String.Format("{0:n0}", Math.Round(Player.Local.Vyndalium, 2))</span>
                            </div>
                            <div class="online-players">
                                <span class="players-header">Online: @Connection.All.Count</span>
                                @foreach (var entry in Connection.All)
                                {
                                    <div class="player-entry">
                                        @if (entry.IsHost)
                                        {
                                            <span class="host-badge">👑</span>
                                        }
                                        <span class="player-name">@entry.DisplayName</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT PANEL: Inventory & Tabs -->
                    <div class="inventory-panel-right">
                        <div class="inventory-tabs">
                            <button class="tab-button @(true ? "active" : "")" @onclick="@(() => ShowPanel(PanelType.Inventory))">Rucksack</button>
                            <button class="tab-button" @onclick="@(() => ShowPanel(PanelType.Food))">Charakter</button>
                            <button class="tab-button" @onclick="@(() => ShowPanel(PanelType.Abilities))">Fähigkeiten</button>
                        </div>

                        <!-- INVENTORY GRID -->
                        <div class="inventory-section">
                            <div class="inventory-controls">
                                <span class="section-header">Gegenstände (@Player.Local.Inventory.BackpackItems.Count)</span>
                                <div class="sort-buttons">
                                    <button class="sort-btn" @onclick="@(() => SortBackpackItems(SortOption.Tier))" title="Nach Seltenheit sortieren">
                                        <span class="sort-icon">▲▼</span>
                                    </button>
                                    <button class="sort-btn" @onclick="@(() => SortBackpackItems(SortOption.ItemLevel))" title="Nach Gegenstandsstufe sortieren">
                                        <span class="sort-icon">Lvl</span>
                                    </button>
                                    <button class="sort-btn" @onclick="@(() => SortBackpackItems(SortOption.RequiredLevel))" title="Nach erforderlicher Stufe sortieren">
                                        <span class="sort-icon">Req</span>
                                    </button>
                                    <button class="sort-btn" @onclick="@(() => SortBackpackItems(SortOption.Material))" title="Nach Material sortieren">
                                        <span class="sort-icon">Mat</span>
                                    </button>
                                    <button class="sort-btn" @onclick="@(() => SortBackpackItems(SortOption.Favorite))" title="Favoriten anzeigen">
                                        <span class="sort-icon">★</span>
                                    </button>
                                </div>
                            </div>

                            <div class="inventory-grid">
                                @for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
                                {
                                    var item = Player.Local.Inventory.BackpackItems[index];
                                    <InventorySlot Item=@item BackpackSlotIndex=@index class="inventory-grid-item" />
                                }
                            </div>
                        </div>

                        <!-- BAGPACK SECTION -->
                        @{
                            var backpackBagItems = Player.Local.Inventory.BackpackBagItems;
                        }
                        @if (backpackBagItems.Count > 0)
                        {
                            <div class="bagpack-section">
                                <div class="inventory-controls">
                                    <span class="section-header bagpack-header">Tasche (@backpackBagItems.Count)</span>
                                    <div class="sort-buttons">
                                        <button class="sort-btn" @onclick="@(() => SortBackpackBagItems(SortOption.Tier))" title="Nach Seltenheit sortieren">
                                            <span class="sort-icon">▲▼</span>
                                        </button>
                                        <button class="sort-btn" @onclick="@(() => SortBackpackBagItems(SortOption.ItemLevel))" title="Nach Gegenstandsstufe sortieren">
                                            <span class="sort-icon">Lvl</span>
                                        </button>
                                        <button class="sort-btn" @onclick="@(() => SortBackpackBagItems(SortOption.RequiredLevel))" title="Nach erforderlicher Stufe sortieren">
                                            <span class="sort-icon">Req</span>
                                        </button>
                                        <button class="sort-btn" @onclick="@(() => SortBackpackBagItems(SortOption.Material))" title="Nach Material sortieren">
                                            <span class="sort-icon">Mat</span>
                                        </button>
                                        <button class="sort-btn" @onclick="@(() => SortBackpackBagItems(SortOption.Favorite))" title="Favoriten anzeigen">
                                            <span class="sort-icon">★</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="inventory-grid bagpack-grid">
                                    @foreach (var item in backpackBagItems)
                                    {
                                        <InventorySlot Item=@item class="inventory-grid-item" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                break;
            case PanelType.Food:
                <div class="Food" style="display: flex;">
                    <CharacterMenu/>
                </div>
                break;
            case PanelType.Abilities:
                <div class="Abilities" style="display: flex;">
                    <Abilities/>
                </div>
                break;
        }
    </div>
</root>

@code
{
    public Hud hud;
    private SortDirection currentSortDirection = SortDirection.Ascending;

    private void SortBackpackItems(SortOption sortOption)
    {
        // Umschalten der Sortierrichtung
        currentSortDirection = currentSortDirection == SortDirection.Ascending
        ? SortDirection.Descending
        : SortDirection.Ascending;

        Player.Local.Inventory?.SortBackpackItems(sortOption);
    }
    private void SortBackpackBagItems(SortOption sortOption)
    {
        // Umschalten der Sortierrichtung
        currentSortDirection = currentSortDirection == SortDirection.Ascending
        ? SortDirection.Descending
        : SortDirection.Ascending;

        Player.Local.Inventory?.SortBackpackBagItems(sortOption);
    }

    private Player player { get; set; }

    CharacterRenderer _renderer;

    public static Inventory Instance { get; private set; }
    public static bool IsDragging { get; private set; }
    public Inventory() => Instance = this;

    public enum PanelType
    {
        Inventory,
        Food,
        Weapons,
        Abilities,
        Armor,
        Materials,
        Potions
    }

    private PanelType ActivePanel { get; set; } = PanelType.Inventory;
    public void ShowPanel(PanelType panel)
    {
        ActivePanel = panel;
        panelShownTime = 5;
    }

    private RealTimeSince panelShownTime;
    public void Inspect(ItemComponent item)
    {
        if (item is not null)
            AddChild(new InspectItem(item));
    }
    public void OnChanged()
    {
        // _renderer.Refresh();
    }

    protected override int BuildHash()
    {
        if (Player.Local is null || Player.Local.Inventory == null)
            return -1;

        return HashCode.Combine(
        Player.Local.Level,
        Player.Local.Inventory.BackpackItems.HashCombine(i => i?.GetHashCode() ?? -1),
        Player.Local.Inventory.BackpackBagItems.HashCombine(i => i?.GetHashCode() ?? -1),
        Player.Local.Inventory.EquippedItems.HashCombine(i => i?.GetHashCode() ?? -1)
        );
    }
}
