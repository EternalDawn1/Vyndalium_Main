@inherits Panel
@namespace GeneralGame.HUD
@attribute [StyleSheet]


<root>
	<SideButton OnClick=@(() =>
		FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud)) IsInverted=@(true)
		ImagePath="ui/hud/exit.gif" style="position: absolute; top: 30px; right: 0px;" style="z-index: 100;" />
	
	<div class="sidehud">
		<SideButton OnClick=@(() => ShowPanel(PanelType.Inventory)) IsInverted=@(true)
			ImagePath="ui/hud/inventory.png" title="Inventory" TitleStyle="font-size: 16px;transform: rotate(-45deg); left:5%; position:absolute;"  />

		<SideButton OnClick=@(() => ShowPanel(PanelType.Food)) IsInverted=@(true) ImagePath="ui/hud/food.png" title="Player" TitleStyle="font-size: 16px;transform: rotate(-45deg); left:5%; position:absolute;"   />

		<SideButton OnClick=@(() => ShowPanel(PanelType.Weapons)) IsInverted=@(true) ImagePath="ui/hud/weapons.png" title="Crafting" TitleStyle="font-size: 16px;transform: rotate(-45deg); left:5%;top:25%; position:absolute;"  />
		<SideButton OnClick=@(() => ShowPanel(PanelType.Armor)) IsInverted=@(true) ImagePath="ui/hud/armor.png" />
		<SideButton OnClick=@(() => ShowPanel(PanelType.Materials)) IsInverted=@(true)
			ImagePath="ui/hud/materials.png" />
		<SideButton OnClick=@(() => ShowPanel(PanelType.Potions)) IsInverted=@(true) ImagePath="ui/hud/potions.png" />
		
	</div>
	<div class="list" CanDragScroll="false" >
		<div class="inventory" style="opacity: @(currentPanel == PanelType.Inventory ? 1 : 0)">
			
			

			<div class="section">
				<div class="character">
					<div class="char"><CharacterRenderer @ref=_renderer /></div>
						<div class="box">

						<div class="EquippedItems">
							<div class="helmet">
								<InventorySlot EquipSlotIndex=@EquipSlot.Head style="background: linear-gradient(to right, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Head] />
								<InventorySlot EquipSlotIndex=@EquipSlot.Face style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Face] />
							</div>
							<div class="armor">
								<InventorySlot EquipSlotIndex=@EquipSlot.Hand style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Hand] />
								<InventorySlot EquipSlotIndex=@EquipSlot.Body style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Body] />
								<InventorySlot EquipSlotIndex=@EquipSlot.Back style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Back] />
								<InventorySlot EquipSlotIndex=@EquipSlot.Bracer style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Bracer] />
							</div>
							<div class="pants">
								<InventorySlot EquipSlotIndex=@EquipSlot.Legs style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Legs] />
								<InventorySlot EquipSlotIndex=@EquipSlot.Belt style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Belt] />
							</div>
							
							
								
							
								<InventorySlot EquipSlotIndex=@EquipSlot.Feet style="background: linear-gradient(to right, rgba(80, 7, 7, 0.8) 0%, rgba(65, 9, 9, 0.774) 50%, rgba(8, 0, 0, 0.767) 100%);"
								Item=@Player.Local.Inventory.EquippedItems[(int)EquipSlot.Feet] />
							
						</div>
				
					</div>
				</div>

			</div>

			<div class="section2" CanDragScroll="false">
				<div class="box">
					<button class="sort" @onclick="@(() => @SortBackpackItems(SortOption.Tier))">
						<div class="tooltip">Tier</div>
						⚙️</button>
					<button class="sort" @onclick="@(() => @SortBackpackItems(SortOption.ItemLevel))">
						<div class="tooltip">ItemLevel</div>
						💿</button>
					<button class="sort" @onclick="@(() => @SortBackpackItems(SortOption.RequiredLevel))">
						<div class="tooltip">Req. Level</div>
						📀</button>
					<button class="sort" @onclick="@(() => @SortBackpackItems(SortOption.Material))">
						<div class="tooltip">Material</div>
						📦</button>
					<button class="sort" @onclick="@(() => @SortBackpackItems(SortOption.Favorite))">
						<div class="tooltip">Favorite</div>
						⭐️</button>

				</div>

				<div class="Hello">Inventory</div>
				<div class="items ">
				@for (var index = 0; index < Player.Local.Inventory.BackpackItems.Count; index++)
				{
					var item = Player.Local.Inventory.BackpackItems[index];
					<InventorySlot Item=@item BackpackSlotIndex=@index />
				}

				</div>
				@{
					var backpackBagItems = Player.Local.Inventory.BackpackBagItems;
				}
				@if (backpackBagItems.Count > 0)
				{
					<div class="box2">
						<button class="sort" @onclick="@(() => @SortBackpackBagItems(SortOption.Tier))">
							<div class="tooltip">Tier</div>
							⚙️</button>
						<button class="sort" @onclick="@(() => @SortBackpackBagItems(SortOption.ItemLevel))">
							<div class="tooltip">ItemLevel</div>
							💿</button>
						<button class="sort" @onclick="@(() => @SortBackpackBagItems(SortOption.RequiredLevel))">
							<div class="tooltip">Req. Level</div>
							📀</button>
						<button class="sort" @onclick="@(() => @SortBackpackBagItems(SortOption.Material))">
							<div class="tooltip">Material</div>
							📦</button>
						<button class="sort" @onclick="@(() => @SortBackpackBagItems(SortOption.Favorite))">
							<div class="tooltip">Favorite</div>
							⭐️</button>
					</div>
					<div class="Hello"
						style="top:4.5%;background: linear-gradient(90deg, rgb(82, 74, 74) 0%, rgb(3, 110, 35) 50%, rgb(10, 211, 53) 100%);">
						Bag Pack</div>
					
				}
				
				<div class="items2 @((Inventory.IsDragging ? "dragging" : "inventory-scrollable"))">
					@for (var index = 0; index < backpackBagItems.Count; index++)
					{
						var item = backpackBagItems[index];
						<InventorySlot Item=@item BackpackPackSlotIndex=@index />
					}
				</div>

				<div style="align-items: center; margin: 20px 5px;"></div>
			</div>
		</div>
		<div class="Food" style="opacity: @(currentPanel == PanelType.Food ? 1 : 0)">
			<CharacterMenu/>

		</div>
		<div class="Weapons" style="opacity: @(currentPanel == PanelType.Weapons ? 1 : 0)">
			<!-- Weapons Content -->
		</div>
		<div class="Armor" style="opacity: @(currentPanel == PanelType.Armor ? 1 : 0)">
			<!-- Armor Content -->
		</div>
		<div class="Materials" style="opacity: @(currentPanel == PanelType.Materials ? 1 : 0)">
			<!-- Materials Content -->
		</div>
		<div class="Potions" style="opacity: @(currentPanel == PanelType.Potions ? 1 : 0)">
			<!-- Potions Content -->
		</div>
			

		



	</div>




</root>

@code
{
	public Hud hud;
	private SortDirection currentSortDirection = SortDirection.Ascending;

	private void SortBackpackItems(SortOption sortOption)
	{
		// Umschalten der Sortierrichtung
		currentSortDirection = currentSortDirection == SortDirection.Ascending
		? SortDirection.Descending
		: SortDirection.Ascending;

		Player.Local.Inventory?.SortBackpackItems(sortOption);
	}
	private void SortBackpackBagItems(SortOption sortOption)
	{
		// Umschalten der Sortierrichtung
		currentSortDirection = currentSortDirection == SortDirection.Ascending
		? SortDirection.Descending
		: SortDirection.Ascending;

		Player.Local.Inventory?.SortBackpackBagItems(sortOption);
	}
	

	private Player player { get; set; }

	
	

	CharacterRenderer _renderer;

	public void UpdateSearch()
	{
		// Hier können Sie Ihren Code hinzufügen, um das Inventar basierend auf searchTerm zu filtern
	}

	public static Inventory Instance { get; private set; }
	public static bool IsDragging { get; private set; }
	public Inventory() => Instance = this;

	public enum PanelType
	{
		Inventory,
		Food,
		Weapons,
		Armor,
		Materials,
		Potions
	}
	
	private PanelType currentPanel = PanelType.Inventory;
	public void ShowPanel(PanelType panel)
	{
		currentPanel = panel;
		panelShownTime = 5;
	}

	private RealTimeSince panelShownTime;
	public void Inspect(ItemComponent item)
	{
		if (item is not null)
			AddChild(new InspectItem(item));
	}
	public void OnChanged()
	{
		_renderer.Refresh();
	}
	

	protected override int BuildHash()
	{

		if (Player.Local is null || Player.Local.Inventory == null)
			return -1;

		return HashCode.Combine(
		Player.Local.Level,
		Player.Local.Inventory.BackpackItems.HashCombine(i => i?.GetHashCode() ?? -1),
		Player.Local.Inventory.BackpackBagItems.HashCombine(i => i?.GetHashCode() ?? -1),
		Player.Local.Inventory.EquippedItems.HashCombine(i => i?.GetHashCode() ?? -1)
		);
	}


}
