@namespace GeneralGame.HUD
@attribute [StyleSheet]
@inherits Panel
@using GeneralGame



<root onclick=@(() => Close())>
    @if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.StorageBox)
    {
        @if (_item != null && StorageBox.Instance.itemStorage.items.Contains(_item))
        {
            <ContextMenuOption Description="Take"
                               ImagePath="ui/hud/hand_slot.png"
                               onclick=@(() => AddItemToPlayerInventory(_item)) />
        }
        else
        {
            <ContextMenuOption Description="Deposit"
                               ImagePath="ui/hud/storage.png"
                               onclick=@(() => DepositItemToStorageBox(_item)) />
        }
    }
	else if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel && ShopPanel.Instance.currentPanel == ShopPanel.PanelType.Inventory)
    {
        @if (_item != null)
        {
            <ContextMenuOption Description="Sell"
                               ImagePath="ui/hud/shop.png"
                               onclick=@(() => SellItem(_item)) />
        }
    }
    else if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel && ShopPanel.Instance.currentPanel == ShopPanel.PanelType.StoreItems)
    {
        @if (_item != null && Player.Local.Inventory.BackpackItems.Contains(_item))
		{
			<ContextMenuOption Description="Move to Storage"
							   ImagePath="ui/hud/storage.png"
							   onclick=@(() => Player.Local.Inventory.MoveItemToStorage(_item)) />
		}
		else
		{
            <ContextMenuOption Description="Move to Backpack"
                               ImagePath="ui/hud/inventory.png"
                               onclick=@(() => Player.Local.Inventory.MoveItemToBackpack(_item)) />
			<ContextMenuOption Description="Sell"
							   ImagePath="ui/hud/shop.png"
							   onclick=@(() => SellItem(_item)) />
        }
    }
    else
    {
        @if (_item is ItemEquipment equipment)
        {
            @if (equipment != null)
            {
                <ContextMenuOption Description=@(equipment.Equipped ? "Unequip" : "Equip")
                                   ImagePath="ui/hud/hand_slot.png"
                                   onclick=@(() => ToggleEquip(equipment)) />
            }
        }
        <ContextMenuOption Description="View"
                           ImagePath="ui/hud/inv_actions_inspect.png"
                           onclick=@(() => Inspect(_item)) />
        <ContextMenuOption Description="Drop"
                           ImagePath="ui/hud/inv_actions_drop.png"
                           onclick=@(() => {
                               Player.Local.Inventory.DropItem(_item);
                               Inventory.Instance?.OnChanged();
                           }) />
        @if (_item != null && _item.Count > 1)
        {
            <ContextMenuOption Description="Split"
                               ImagePath="ui/hud/inv_actions_split.png"
                               onclick=@(() => OpenSplitPanel(_item)) />
        }
       
    }
</root>

@code {
	
	private static Player player => Player.Local;
	
	private static ContextMenu _instance;
	private ItemComponent _item;
	private List<ItemComponent> selectedItems = new();

	
	

	



	private void DepositItemToStorageBox(ItemComponent item)
	{
		if (item == null) return;
		var storageBox = StorageBox.Instance?.itemStorage;
		if (storageBox != null)
		{
			storageBox.Items.Add(item);
			player.Inventory.RemoveItem(item);
			Log.Info($"Item {item.Name} zur StorageBox hinzugefügt.");
			Hudmaster.Instance.ShowNotification($"Deposit {item.Name}","/ui/hud/storage.png");
			Inventory.Instance?.OnChanged();
		}
	}
	
	private void SellItem(ItemComponent item)
	{
		if (item == null) return;
		
		// Entferne das Item aus dem Inventar des Spielers
		player.Inventory.RemoveItem(item);
		// Füge den Verkaufspreis des Items zum Vyndalium des Spielers hinzu
		player.Vyndalium += item.SellPrice;
		Log.Info($"Item {item.Name} verkauft für {item.SellPrice} Vyndalium.");
		Hudmaster.Instance.ShowNotification($"Item {item.Name} was sold for {item.SellPrice} Vyndalium.", "/ui/hud/shop.png");

		Inventory.Instance?.OnChanged();
	}
	private void AddItemToPlayerInventory(ItemComponent item)
    {
        if (item == null) return;

        var inventory = player.Inventory;
        var firstFreeSlot = inventory._backpackItems.IndexOf(null);

        // Überprüfen Sie, ob das Item bereits im Inventar ist
        if (inventory._backpackItems.Contains(item))
        {
            Log.Info($"Item {item.Name} ist bereits im Inventar.");
            return;
        }

        // Überprüfen Sie, ob ein freier Slot verfügbar ist
        if (firstFreeSlot != -1)
        {
            // Fügen Sie das Item in den ersten freien Slot ein
            inventory._backpackItems[firstFreeSlot] = item;
            item.State = ItemState.Backpack; // Aktualisieren Sie den Zustand des Items
            

            // Entfernen Sie das Item aus der StorageBox
            var storageBox = StorageBox.Instance?.itemStorage;
            if (storageBox != null && storageBox.Items.Contains(item))
            {
                storageBox.Items.Remove(item);
                
            }

            Inventory.Instance?.OnChanged();
			Hudmaster.Instance.ShowNotification($"received {item.Name}", "/ui/hud/hand_slot.png");
        }
        else
        {
            Log.Error("Kein freier Slot im Rucksack verfügbar.");
        }
    }
	private void SellAllSelectedItems()
	{
		foreach (var item in selectedItems)
		{
			SellItem(item);
		}
		selectedItems.Clear();
		Inventory.Instance?.OnChanged();
	}

	private void ToggleSelectItem(ItemComponent item)
	{
		if (selectedItems.Contains(item))
		{
			selectedItems.Remove(item);
		}
		else
		{
			selectedItems.Add(item);
		}
	}
	private bool IsItemInEquipSlot(ItemComponent item)
    {
        return player.Inventory.EquippedItems.Contains(item);
    }
	
	public static void Open(ItemComponent item)
	{
		

		Close();

		var fraction = Mouse.Position / Screen.Size;

		_instance = new();
		_instance.Style.Left = Length.Fraction(fraction.x);
		_instance.Style.Top = Length.Fraction(fraction.y);
		_instance._item = item;
		_instance.PlaySound("light_click");

		Hudmaster.Instance.Panel.AddChild(_instance);
	}
	private void OpenSplitPanel(ItemComponent item)
	{
		SplitPanel.Open(item);
	}

	public static bool IsOpen()
	{
		return _instance != null && _instance.IsValid();
	}

	public static void Close()
	{
		_instance?.Delete();
		_instance = null;
	}

	private void Inspect(ItemComponent item)
	{
		Inventory.Instance.Inspect(item);
		CharacterMenu.Instance.Inspect(item);
	}

	private void ToggleEquip(ItemEquipment equipment)
	{
		if (equipment == null)
		{
			
			return;
		}

		if (equipment.Equipped)
			Player.Local.Inventory?.UnequipItem(equipment);
		else
			Player.Local.Inventory?.EquipItemFromBackpack(equipment);

		Inventory.Instance?.OnChanged();
	}

	public override void Tick()
	{

		var mousePosition = Mouse.Position;
		var boxRect = Box.Rect.Grow(25f);

		if (!boxRect.IsInside(mousePosition))
			Close();
		if (FullScreenManager.Instance.ActivePanel != FullScreenManager.FullScreenPanel.Inventory)
		if (FullScreenManager.Instance.ActivePanel != FullScreenManager.FullScreenPanel.StorageBox)
		if (FullScreenManager.Instance.ActivePanel != FullScreenManager.FullScreenPanel.ShopPanel)
		
		
			Close();
		
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(_item is ItemEquipment);
	}
}
