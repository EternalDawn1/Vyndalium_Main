@namespace GeneralGame.HUD
@attribute [StyleSheet]
@inherits Panel
@using GeneralGame



<root onclick=@(() => Close())>
	
	@if (_item is ItemEquipment equipment)
	{
		@if(equipment != null)
		{
			<ContextMenuOption ] Description=@(equipment.Equipped ? "Unequip" : "Equip")
			ImagePath="ui/hud/hand_slot.png" onclick=@(() => ToggleEquip(equipment)) />
		}
		
	}
	<ContextMenuOption ] Description="View" ImagePath="ui/hud/inv_actions_inspect.png" onclick=@(() =>
		Inspect(_item)) />
	<ContextMenuOption ] Description="Drop" ImagePath="ui/hud/inv_actions_drop.png" onclick=@(() => {
		Player.Local.Inventory.DropItem(_item); Inventory.Instance?.OnChanged(); }) />
	@if (_item != null && _item.Count > 1)
    {
        <ContextMenuOption Description="Split" ImagePath="ui/hud/inv_actions_split.png" onclick=@(() =>
            OpenSplitPanel(_item)) />
    }
	@if (_item != null && _item.SellPrice > 0 && IsInHomebase())
	{
		<ContextMenuOption Description="Sell" ImagePath="ui/hud/inv_actions_sell.png" onclick=@(() => SellItem(_item)) />
	}

</root>

@code {

	private static Player player => Player.Local;
	private static ContextMenu _instance;
	private ItemComponent _item;

	private void SellItem(ItemComponent item)
	{
		if (item == null) return;

		if (!IsInHomebase())
		{
			Log.Info("Du kannst Items nur in der StartBase-Szene verkaufen.");
			return;
		}

		// Entferne das Item aus dem Inventar des Spielers
		player.Inventory.RemoveItem(item);

		// Füge den Verkaufspreis des Items zum Vyndalium des Spielers hinzu
		player.Vyndalium += item.SellPrice;

		Log.Info($"Item {item.Name} verkauft für {item.SellPrice} Vyndalium.");
	}
	private bool IsInHomebase()
	{
		if (SceneHandler2.CurrentScene == GeneralScene2.StartBase)
		{
			return true;
			Log.Info("Du bist in der StartBase-Szene.");
		}
		return false;
		Log.Info("Du bist nicht in der StartBase-Szene.");
		
	}
	public static void Open(ItemComponent item)
	{
		

		Close();

		var fraction = Mouse.Position / Screen.Size;

		_instance = new();
		_instance.Style.Left = Length.Fraction(fraction.x);
		_instance.Style.Top = Length.Fraction(fraction.y);
		_instance._item = item;
		_instance.PlaySound("light_click");

		Hudmaster.Instance.Panel.AddChild(_instance);
	}
	private void OpenSplitPanel(ItemComponent item)
	{
		SplitPanel.Open(item);
	}

	public static bool IsOpen()
	{
		return _instance != null && _instance.IsValid();
	}

	public static void Close()
	{
		_instance?.Delete();
		_instance = null;
	}

	private void Inspect(ItemComponent item)
	{
		Inventory.Instance.Inspect(item);
	}

	private void ToggleEquip(ItemEquipment equipment)
	{
		if (equipment == null)
		{
			
			return;
		}

		if (equipment.Equipped)
			Player.Local.Inventory?.UnequipItem(equipment);
		else
			Player.Local.Inventory?.EquipItemFromBackpack(equipment);

		Inventory.Instance?.OnChanged();
	}

	public override void Tick()
	{

		var mousePosition = Mouse.Position;
		var boxRect = Box.Rect.Grow(25f);

		if (!boxRect.IsInside(mousePosition))
			Close();
		if (FullScreenManager.Instance.ActivePanel != FullScreenManager.FullScreenPanel.Inventory)
			Close();
		
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(_item is ItemEquipment);
	}
}
