@namespace GeneralGame.HUD
@using Sandbox.Citizen
@attribute [StyleSheet]
@using Sandbox.Utility
@inherits Panel

<root>
    <div class="scene-container">
        <ScenePanel @ref=_scenePanel />
        <div class="scene-input-overlay" @ref=SceneInputOverlayPanel></div>
    </div>
</root>

@code {
    private Scene _scene;
    private ScenePanel _scenePanel;
    private GameObject _characterObject;
    private ModelRenderer _characterRenderer;
    private List<GameObject> _clothingObjects = new List<GameObject>();
    
    private const float HoverEffectDuration = 0.2f;
    private TimeUntil _hoverEffectActivation = HoverEffectDuration;
    private TimeUntil _hoverEffectDeactivation = HoverEffectDuration;

    private static float _yaw = 0f;
    private bool _isDragging = false;
    private Panel SceneInputOverlayPanel { get; set; }

    public bool IsHoveredByMouse() => SceneInputOverlayPanel.Box.Rect.IsInside( Mouse.Position );

    protected override void OnAfterTreeRender(bool firstTime)
    {
        base.OnAfterTreeRender(firstTime);

        if (_scene == null)
        {
            _scene = new Scene();
            
            // Erstelle Character GameObject
            _characterObject = _scene.CreateObject();
            _characterRenderer = _characterObject.Components.Create<ModelRenderer>();
            _characterRenderer.Model = Model.Load("models/citizen/citizen.vmdl");
            _characterObject.WorldRotation = Rotation.From(0, _yaw, 0);
            
            // Erstelle Lichter
            var lightObject = _scene.CreateObject();
            var light = lightObject.Components.Create<PointLight>();
            light.LightColor = Color.White * 0.4f;
            light.Radius = 1000f;  // Änderung: LightRadius -> Range
            lightObject.WorldPosition = Vector3.Forward * 15f;
            
            var dirLightObject = _scene.CreateObject();
            var dirLight = dirLightObject.Components.Create<DirectionalLight>();
            dirLight.LightColor = Color.White * 0.5f;
            dirLightObject.WorldRotation = Rotation.From(-45, -45, 45);
            
            // Erstelle Kamera
            var cameraObject = _scene.CreateObject();
            var camera = cameraObject.Components.Create<CameraComponent>();
            camera.FieldOfView = 5f;
            camera.ZNear = 3f;
            
            // Positioniere Kamera, um das Modell zu zeigen
            cameraObject.WorldPosition = _characterObject.WorldPosition + Vector3.Backward * 100f + Vector3.Up * 10f;
            RotateToLookAt(cameraObject, _characterObject.WorldPosition);
        }

        if (firstTime) Refresh();

        // ScenePanel mit der Szene verbinden
        if (_scenePanel != null)
        {
            _scenePanel.Scene = _scene;  // Diese Zuweisung ist korrekt
            
            // Lichter positionieren
            UpdateLights();
        }
    }
    
    private void RotateToLookAt(GameObject obj, Vector3 target)
    {
        var direction = (target - obj.WorldPosition).Normal;
        obj.WorldRotation = Rotation.LookAt(direction);
    }
    
    private void UpdateLights()
    {
        var camera = _scene.Components.GetAll<CameraComponent>().FirstOrDefault();
        if (camera == null) return;
        
        var pointLight = _scene.Components.GetAll<PointLight>().FirstOrDefault();
        if (pointLight != null)
        {
            pointLight.GameObject.WorldPosition = camera.GameObject.WorldPosition + camera.GameObject.WorldRotation.Forward * 500f;
        }
        
        var dirLight = _scene.Components.GetAll<DirectionalLight>().FirstOrDefault();
        if (dirLight != null)
        {
            dirLight.GameObject.WorldPosition = camera.GameObject.WorldPosition + 
                camera.GameObject.WorldRotation.Forward * 500f + 
                camera.GameObject.WorldRotation.Up * 500f;
            dirLight.GameObject.WorldRotation = camera.GameObject.WorldRotation * Rotation.From(0, -25, 25);
            dirLight.LightColor = Color.White * 0.4f;
        }
    }

    public void Refresh()
    {
        var inventory = Player.Local?.Inventory;
        if (inventory == null)
            return;

        // Rest der Methode bleibt unverändert
        // ...
    }
    
    private void Update()
    {
        if (_characterObject == null || Player.Local == null || Player.Local.Inventory == null)
            return;

        var mousePos = Mouse.Position;
        
        // Fixiere Kameraposition zu Character
        var camera = _scene.Components.GetAll<CameraComponent>().FirstOrDefault();
        if (camera != null)
        {
            // Anpassen des "Look At" Parameters für den Character basierend auf der Mausposition
            var headPos = new Vector2(Box.Rect.Center.x, Box.Rect.Center.y);
            var localPos = mousePos - headPos;
            
            // CitizenAnimationHelper korrigieren
            if (_characterObject.Components.TryGet<CitizenAnimationHelper>(out var animHelper))
            {
                // Korrigiert: Vector3 für LookAt, nicht GameObject
				animHelper.WithLook(new Vector3(
				-MathF.Atan2(-localPos.y, 1000f) * 180f / MathF.PI,
				MathF.Atan2(localPos.x, 1000f) * 180f / MathF.PI,
				0f
				).Normal);
            }
        }

        // Rest der Methode bleibt unverändert
        // ...
    }
    
    // Hilfsmethode zum Abrufen einer Attachment-Position
    private Vector3 GetAttachmentPosition(string attachmentName, GameObject character)
    {
        // Vereinfachte Implementierung bleibt
        return character.WorldPosition + Vector3.Up * 10f;
    }

    public override void OnButtonEvent(ButtonEvent e)
    {
        if (e.Button == "mouseleft")
            _isDragging = e.Pressed;

        base.OnButtonEvent(e);
    }
    
    public override void Tick()
    {
        // Diese Methode bleibt unverändert
        // ...
    }
}