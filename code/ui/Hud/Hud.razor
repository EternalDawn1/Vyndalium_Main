@using System
@using System.Linq
@using Sandbox
@inherits PanelComponent
@namespace GeneralGame.HUD




<root>
	
	

	
	
	@if (FullScreenManager.Instance?.ActivePanel != FullScreenManager.FullScreenPanel.InGameHud)
	{
		return; // Exit early if FullScreenManager is active
	}
	<div class="scene-name">@SceneHandler2.GetSceneName(SceneHandler2.CurrentScene)</div>

	<div class="level-up-panel @levelUpClass">
		<div class="level-up-content">
			@if (player != null)
			{
				<p class="txt">Lvl.@player.Level</p>
			}

		</div>
	</div>
	@if (npc != null && npc.IsBoss)
	{
		<div class="boss-ui">
			<div class="npc-level @GetLevelClass(npc.Level)">Lvl.@npc.Level</div>
			<div class="boss-healthbar-container @(npc.Health > 0 ? "show" : "")">
				<div class="boss-healthbar">
					<div class="inner">
						
						<div class="backbar"
							style="width: @(npc.PreviousHealth / npc.MaxHealth * 100f)%; position: absolute; top: 3; left: 0; height: 80%; background-color: rgba(255, 255, 0, 0.5); z-index: 1;">
						</div>
						<!-- Fill -->
						<div class="fill"
							style="width: @(npc.Health / npc.MaxHealth * 100f)%; position: absolute; top: 3; left: 0; height: 80%; background-color: @GetHealthBarColor2(); z-index: 2;">
						</div>
					</div>
				</div>
				<p class="boss-name">@npc.Name</p>
			</div>
		</div>
	}
	</Minimap>

	@{
		if (player is null)
			return;
		var weapon = player.Weapons.Deployed;

		BaseGun bsGun = null;
	}

	@if (weapon.IsValid() && weapon.Components.GetInDescendantsOrSelf<BaseGun>(true).IsValid())
	{
		bsGun = weapon.Components.GetInDescendantsOrSelf<BaseGun>();
	}


	@if (bsGun.IsValid() && player.LifeState == LifeState.Alive && !bsGun.IsMelee)
	{

		<div class="ammo">
			@{
				var totalAmmo = player.Ammo.Get(bsGun.AmmoType);
			}
			<div class="ammo-icon"></div>
			<label class="clip">@bsGun.AmmoInClip</label>/<label class="total">@totalAmmo</label>
			
			
		</div>

	}
	@if (bsGun != null && bsGun.chargeComponent != null)
	{
		<div class="charge-bar">
			<div class="charge-bar-inner" style="width: @(bsGun.chargeComponent.Charge * 100)%;">
				@{
					var chargePercentage = bsGun.chargeComponent.Charge * 100;
				}
				
			</div>
		</div>
	}
	
	


	<div class="center">
		@if (!weapon.IsValid() && player.IsValid())
		{
			<div class="crosshair1">
				<div class="bar vertical top"></div>
				<div class="bar vertical bottom"></div>
				<div class="bar horizontal left"></div>
				<div class="bar horizontal right"></div>
			</div>
		}
		else
		{
			@if (player.IsAiming && player.IsValid())
			{
				<div class="crosshair1">
					<div class="bar vertical top"></div>
					<div class="bar vertical bottom"></div>
					<div class="bar horizontal left"></div>
					<div class="bar horizontal right"></div>
				</div>
			}
			else
			{
				<div class="crosshair1">
					<div class="bar vertical top"></div>
					<div class="bar vertical bottom"></div>
					<div class="bar horizontal left"></div>
					<div class="bar horizontal right"></div>
				</div>
			}
		}


	</div>





	@if (player != null)
	{
		<div class="expbar">
			<ExperienceBar IsInventoryScreen=@true style="opacity: 1;" />
		</div>

		<div class="vyndalium">
			<div class="vyndalium1">
				
				<div class="P">
					<div class="icon1"></div>
					<div class="number">$@String.Format("{0:n0}", Math.Round(Player.Local.Vyndalium, 2))</div>

				</div>
			</div>

		</div>
		<div class="feed">
			Testinhalt
			<Feed style="opacity: 1;" />
		</div>


		<div class="healthbar">
			<div class="healthbar" style="background-color: @GetHealthBarColor();">
				<div class="inner">
					<div class="fill @(GetHealthBarClass())"
						style="width: @(player.Health / player.MaxHealth * 100f)%; background-color: @GetHealthBarColor(); color: @GetTextColor();">
						
					</div>
				</div>
				<p style="color: @GetTextColor();"> <div class="icon-hp"></div> @Math.Round(player.Health) / @Math.Round(player.MaxHealth)</p>
			</div>
		</div>

		

		<div class="staminabar" style="opacity: @(player.IsRunning ? 1 : 0);">
			<div class="staminabar">
				<div class="staminainner">
					<div class="fill" style="width: @(player.Stamina/player.MaxStamina *  100f)%">
					</div>
				</div>
			</div>
		</div>
		

		<div class="hud-container">
			<div class="about">
				@if (player?.Connection != null && player?.Connection.SteamId > 0)
				{
					<div class="avatar" style="background-image: url( avatar:@player.Connection.SteamId )"></div>
					<div class="a">@player.Connection.DisplayName</div>
					<div class="rank" style="color: @player.GetRankColor();">@player.GetRankName()</div>
					@if (player.PrestigeLevel > 0)
					{
						<div class="prestige">🅿️ @ToRoman(player.PrestigeLevel)</div>
					}
					
				}
			</div>
			
			
			<div class="b">@player.Level</div>
			
			

	
		</div>
	}
	
		
	


</root>

@code
{
	public Hud hud;

	[Property] private Npc npc { get; set; } = new Npc();
	

	private string GetLevelClass(int level)
	{
		if (level >= 100) return "level-100";
		if (level >= 90) return "level-90";
		return "level-1";
	}
	[Property] public Gradient HealthGradient { get; set; }
	
	private Player player { get; set; }

	private TimeSpan playTime = TimeSpan.Zero;

	private DateTime lastUpdateTime = DateTime.Now;
	private string levelUpClass = "hidden";

	private async void ShowLevelUpPanel()
	{
		levelUpClass = "visible";
		StateHasChanged();
		await Task.Delay(2000);
		levelUpClass = "hidden";
		StateHasChanged();
	}
	private void OnPlayerLevelUp(int level)
	{
		ShowLevelUpPanel();
	}

	
	
	protected override void OnFixedUpdate()
	{
		if (player == null || !player.IsValid())
		{
			player = Scene.GetAllComponents<Player>().FirstOrDefault(p => p.Network.Owner == Connection.Local);
			if (player == null)
			{
				return; // Frühzeitiger Abbruch, wenn kein gültiger Spieler gefunden wird
			}
			player.OnLevelUp += OnPlayerLevelUp;
		}
		if (npc == null || !npc.IsValid())
		{
			npc = Scene.GetAllComponents<Npc>().FirstOrDefault(n => n.IsBoss);
		}
		

	

		

		
	
		

		StateHasChanged();
	}
	
	protected override void OnAwake()
	{
		if (player != null)
		{
			player.OnLevelUp += (level) => ShowLevelUpPanel();
			StateHasChanged();
			
		}
		
	}
	private float previousHealth;

	protected override void OnUpdate()
	{
		if (npc != null)
		{
			// Aktualisiere die Backbar, wenn Schaden genommen wurde
			if (npc.Health < previousHealth)
			{
				npc.PreviousHealth = previousHealth; // Speichere den vorherigen Zustand
				StateHasChanged();

				
				
			}

			previousHealth = npc.Health; // Aktualisiere den vorherigen Gesundheitswert
		}

		if (npc != null && npc.Health <= 0)
		{
			this.Destroy();
		}
	}
	private string GetHealthBarColor()
	{
		var healthPercentage = player.Health / player.MaxHealth;
		return HealthGradient.Evaluate(healthPercentage).ToString();
	}
	private string GetHealthBarColor2()
	{
		var healthPercentage = npc.Health / npc.MaxHealth;
		return HealthGradient.Evaluate(healthPercentage).ToString();
	}

	private string GetTextColor()
	{
		var healthPercentage = player.Health / player.MaxHealth;
		// Berechne die Textfarbe basierend auf dem Gesundheitsprozentsatz
		var colorValue = (int)(255 * (1 - healthPercentage));
		colorValue = Math.Clamp(colorValue, 0, 255); // Stelle sicher, dass der Wert zwischen 0 und 255 liegt
		return $"rgb({colorValue}, {colorValue}, {colorValue})"; // Von Weiß (255,255,255) zu Schwarz (0,0,0)
	}
	private string ToRoman(int number)
	{
		if (number < 1 || number > 10) return string.Empty;
		string[] romanNumerals = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" };
		return romanNumerals[number - 1];
	}

	private string GetHealthBarClass()
	{
		if (player.Health == player.MaxHealth)
		{
			return "full-hp";
		}
		else if (player.Health < player.MaxHealth * 0.25)
		{
			return "low-hp";
		}
		return string.Empty;
	}
	



	protected override int BuildHash() =>
	HashCode.Combine
	(
	RealTime.Now,
	player?.Experience,

	player?.Level,
	player?.GetRankName()
	);
}
