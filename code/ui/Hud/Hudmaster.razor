@namespace GeneralGame.HUD
@inherits PanelComponent
@using Sandbox;
@using Sandbox.UI;

<root>
    <FullScreenManager />
    <NotificationPanel @ref="notificationPanel" />
    @if (showConfirmationDialog)
    {
	
        <div class="confirmation-dialog">
            <div class="confirmation-content">
                <p>@confirmationMessage</p>
                <button class="confirmation-button" @onclick="@ConfirmAction">Yes</button>
                <button class="confirmation-button" @onclick="@CancelAction">No</button>
            </div>
        </div>
    }
</root>

@code
{
    public static Hudmaster Instance { get; private set; }
    private NotificationPanel notificationPanel;
    private bool showConfirmationDialog { get; set; }
    private string confirmationMessage { get; set; }
    private Action confirmActionCallback { get; set; }

    public Hudmaster()
    {
        Instance = this;
    }

    public void ShowConfirmationDialog(string message, Action confirmAction)
    {
        confirmationMessage = message;
        confirmActionCallback = confirmAction;
        showConfirmationDialog = true;
        StateHasChanged();
    }

    private void ConfirmAction()
    {
        showConfirmationDialog = false;
        confirmActionCallback?.Invoke();
        StateHasChanged();
    }

    private void CancelAction()
    {
        showConfirmationDialog = false;
        StateHasChanged();
    }

    public void ShowNotification(string message, string icon)
    {
        notificationPanel?.AddNotification(message, icon);
    }
}