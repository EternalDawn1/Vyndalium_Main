@namespace GeneralGame.HUD
@inherits PanelComponent
@using Sandbox;
@using Sandbox.UI;

<root>
    <FullScreenManager />
    <NotificationPanel @ref="notificationPanel" />
    <QuestPanel @ref="questPanel" />
    @if (showCustomDialog)
    {
        <div class="custom-dialog">
            <div class="custom-content">
                <p>@customDialogMessage</p>
                <textarea @bind="customDialogInput" rows="4" cols="50"></textarea>
                <button class="custom-button" @onclick="@ConfirmCustomAction">Submit</button>
                <button class="custom-button" @onclick="@CancelCustomAction">Cancel</button>
            </div>
        </div>
    }
</root>

@code
{
    public static Hudmaster Instance { get; private set; }
    private NotificationPanel notificationPanel;
    private QuestPanel questPanel;
    private bool showCustomDialog { get; set; }
    private string customDialogMessage { get; set; }
    private string customDialogInput { get; set; }
    private Action<string> confirmCustomActionCallback { get; set; }

    public Hudmaster()
    {
        Instance = this;
    }
    public void ShowQuestPanel()
    {
       
    }
    public void QuestPanelStateHasChanged()
    {
        questPanel?.StateHasChanged();
    }

    public void ShowCustomDialog(string message, Action<string> confirmAction)
    {
        
    }

    private void ConfirmCustomAction()
    {
        confirmCustomActionCallback?.Invoke(customDialogInput);
        showCustomDialog = false;
        StateHasChanged();
    }

    private void CancelCustomAction()
    {
        showCustomDialog = false;
        StateHasChanged();
    }

    public void ShowNotification(string message, string icon)
    {
        notificationPanel?.AddNotification(message, icon);
    }
}