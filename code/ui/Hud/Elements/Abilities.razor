            PanelTypeText.AttackSpeed => "| Attack Speed + 5 |",
            PanelTypeText.CriticalChance => "| Critical Chance + 5% |",
            PanelTypeText.CriticalDamage => "| Critical Damage + 5 |",
            PanelTypeText.Endurance => "| Endurance + 1 |",
            PanelTypeText.SlowResistance => "| Slow Resistance + 1 |",
            PanelTypeText.BlindResistance => "| Blind Resistance + 1 |",
            PanelTypeText.StunResistance => "| Stun Resistance + 1 |",
            PanelTypeText.Tenacity => "| Tenacity + 1 |",
            PanelTypeText.Cover => "| Cover + 1 |",
            PanelTypeText.MagicDefense => "| Magic Defense + 5 |",
            PanelTypeText.Armor => "| Armor + 5 |",
            PanelTypeText.Health => "| Health + 10 |",
            PanelTypeText.Dexterity => "| Dexterity + 3 |",
            PanelTypeText.Evasion => "| Evasion + 4 |",
            PanelTypeText.AbilityHaste => "| Ability Haste + 5 |",
            PanelTypeText.Stamina => "| Stamina + 6 |",
            PanelTypeText.PlayerWalkSpeed => "| Player Walk Speed + 7 |",
            PanelTypeText.PlayerRunSpeed => "| Player Run Speed + 8 |",
            PanelTypeText.Mana => "| Mana + 9 |",
