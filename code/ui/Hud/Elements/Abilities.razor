@code{
    
    public static Abilities Instance { get; private set; }
    public Abilities() => Instance = this;
    public void Display()
    {
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.Abilities);
    }
    public void Hide()
    {
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud);
    }
    
   private enum PanelType
    {
        Abilities,
        Endurance,
        Strength,
        Agility,
        Intelligence
    }
    private enum PanelTypeText
    {
        Strength,
        AttackPower,
        ArmorPenetration,
        AttackRange,
        AttackSpeed,
        CriticalChance,
        CriticalDamage,


// Endurance         
        Endurance,
        SlowResistance,
        BlindResistance,
        StunResistance,
        Tenacity,
        Cover,
        MagicDefense,
        Armor,
        Health,

        // Agility
        Dexterity,
        Evasion,
        AbilityHaste,
        Stamina,
        PlayerWalkSpeed,
        PlayerRunSpeed,
        Mana,
        // Intelligence
        Intelligence,
        MagicPower,
        MagicPenetration,
        BonusEXPGain,
        BonusVyndaliumGain

    }
    private string GetPanelText(PanelTypeText panelText)
    {
        return panelText switch
        {
            PanelTypeText.Strength => "Strength increases your physical power and allows you to carry heavier items.",
            PanelTypeText.AttackPower => "Attack Power boosts your damage output.",
            PanelTypeText.ArmorPenetration => "Armor Penetration allows you to bypass enemy defenses.",
            PanelTypeText.AttackRange => "Attack Range extends the distance you can hit enemies.",
            PanelTypeText.AttackSpeed => "Attack Speed increases the rate at which you can attack.",
            PanelTypeText.CriticalChance => "Critical Chance increases the likelihood of landing critical hits.",
            PanelTypeText.CriticalDamage => "Critical Damage boosts the damage of your critical hits.",
            PanelTypeText.Endurance => "Endurance increases your stamina and allows you to perform actions for longer periods.",
            PanelTypeText.SlowResistance => "Slow Resistance reduces the effect of slowing debuffs on you.",
            PanelTypeText.BlindResistance => "Blind Resistance reduces the effect of blinding debuffs on you.",
            PanelTypeText.StunResistance => "Stun Resistance reduces the effect of stunning debuffs on you.",
            PanelTypeText.Tenacity => "Tenacity reduces the duration of crowd control effects on you.",
            PanelTypeText.Cover => "Cover increases your defense when taking cover.",
            PanelTypeText.MagicDefense => "Magic Defense reduces the damage taken from magical attacks.",
            PanelTypeText.Armor => "Armor reduces the damage taken from physical attacks.",
            PanelTypeText.Health => "Health increases your maximum hit points.",
            PanelTypeText.Dexterity => "Dexterity improves your agility and reflexes.",
            PanelTypeText.Evasion => "Evasion increases your chance to dodge attacks.",
            PanelTypeText.AbilityHaste => "Ability Haste reduces the cooldown of your abilities.",
            PanelTypeText.Stamina => "Stamina increases your endurance and energy.",
            PanelTypeText.PlayerWalkSpeed => "Player Walk Speed increases your walking speed.",
            PanelTypeText.PlayerRunSpeed => "Player Run Speed increases your running speed.",
            PanelTypeText.Mana => "Mana is used to cast spells and abilities.",
            PanelTypeText.Intelligence => "Intelligence increases your magical power and knowledge.",
            PanelTypeText.MagicPower => "Magic Power boosts the damage of your magical attacks.",
            PanelTypeText.MagicPenetration => "Magic Penetration allows you to bypass enemy magical defenses.",
            PanelTypeText.BonusEXPGain => "Bonus EXP Gain increases the amount of experience points you earn.",
            PanelTypeText.BonusVyndaliumGain => "Bonus Vyndalium Gain increases the amount of Vyndalium you earn.",

            
            _ => "Unknown ability."
        };
    }
    private string GetPanelText2(PanelTypeText panelText)
    {
        return panelText switch
        {
            PanelTypeText.Strength => "| STG + 1 | Armor + 5 | AttackPower + 5 |",
            PanelTypeText.AttackPower => "| Attack Power + 5 |",
            PanelTypeText.ArmorPenetration => "| Armor Penetration + 5 |",
            PanelTypeText.AttackRange => "| Attack Range + 5 |",
            PanelTypeText.AttackSpeed => "| Attack Speed + 5 |",
            PanelTypeText.CriticalChance => "| Critical Chance + 5% |",
            PanelTypeText.CriticalDamage => "| Critical Damage + 5 |",
            PanelTypeText.Endurance => "| Endurance + 1 |",
            PanelTypeText.SlowResistance => "| Slow Resistance + 1 |",
            PanelTypeText.BlindResistance => "| Blind Resistance + 1 |",
            PanelTypeText.StunResistance => "| Stun Resistance + 1 |",
            PanelTypeText.Tenacity => "| Tenacity + 1 |",
            PanelTypeText.Cover => "| Cover + 1 |",
            PanelTypeText.MagicDefense => "| Magic Defense + 5 |",
            PanelTypeText.Armor => "| Armor + 5 |",
            PanelTypeText.Health => "| Health + 10 |",
            PanelTypeText.Dexterity => "| Dexterity + 3 |",
            PanelTypeText.Evasion => "| Evasion + 4 |",
            PanelTypeText.AbilityHaste => "| Ability Haste + 5 |",
            PanelTypeText.Stamina => "| Stamina + 6 |",
            PanelTypeText.PlayerWalkSpeed => "| Player Walk Speed + 14 |",
            PanelTypeText.PlayerRunSpeed => "| Player Run Speed + 18 |",
            PanelTypeText.Mana => "| Mana + 9 |",
            PanelTypeText.Intelligence => "| Intelligence + 1 |",
            PanelTypeText.MagicPower => "| Magic Power + 2 |",
            PanelTypeText.MagicPenetration => "| Bonus EXP Gain + 15% |",
            PanelTypeText.BonusEXPGain => "| Bonus EXP Gain + 15% |",
            PanelTypeText.BonusVyndaliumGain => "| Bonus Vyndalium Gain + 0,3 |",


            _ => "| Unknown panel text. |"
        };
    }
    private PanelType currentPanel = PanelType.Abilities;
    private PanelTypeText currentPanelText;
    
    private void ShowPanel(PanelType panel)
    {
        currentPanel = panel;
    }
    
    
    private void ShowPanelText(PanelTypeText panelText)
    {
        currentPanelText = panelText;
        StateHasChanged();
        
        
    }
   
   
    
    
   
    public void STGUpgrade()
    {
        if (Player.Local.StatsPoints >= Player.Local.StrengthCost)
        {
            
            Player.Local.STG += 1;
            Player.Local.Armor += 5;
            Player.Local.AttackPower += 15;
            if (Player.Local.PER > 0 && Player.Local.DEX < Player.Local.STG)
            {
                Player.Local.Block += Player.Local.PER;

            }
            if (Player.Local.Block != Player.Local.PER)
            {
                Player.Local.Block = Player.Local.PER;
                Player.Local.Evasion = 0;
            }

            if (Player.Local.STG % 4 == 0)
            {
                Player.Local.MaxStamina -= 2;
                Player.Local.PlayerRunSpeed -= 1;
                Player.Local.MAX_BACKPACK_SLOTS += 1;

            }
            if (Player.Local.STG % 8 == 0)
            {
                Player.Local.MagicPower -= 4;
                Player.Local.MagicDefense += 20;
            }
            if (Player.Local.STG % 20 == 0)
            {
                Player.Local.PER += 8;
                Player.Local.Tenacity += 10;
            }
            Player.Local.StatsPoints -= Player.Local.StrengthCost;
            Player.Local.StrengthCost++;
            

        }
    }

