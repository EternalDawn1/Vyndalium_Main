@namespace GeneralGame.HUD
@inherits Panel
@using Sandbox
@attribute [StyleSheet]



<root>
    <SideButton 
        Title="Exit" 
        
        OnClick=@(() => FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud))
        IsInverted=@(true)
        ImagePath="ui/hud/exit.gif"
        style="position: absolute; top: 30px; right: 0px;" 
    />
    <SideButton 
        Title="Inventory" 
      
        OnClick=@(() => FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.Inventory))
        IsInverted=@(true)
        ImagePath="ui/hud/player.png"
        style="position: absolute; top: 150px; right: 0px;" 
    />
    <SideButton 
        Title="Character Menu" 
      
        OnClick=@(() => FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.CharacterMenu))
        IsInverted=@(true)
        ImagePath="ui/hud/muscles.png"
        style="position: absolute; top: 270px; right: 0px; " 
    />
    <div class="sidehud">
        <SideButton OnClick=@(() => ShowPanel(PanelType.Abilities)) IsInverted=@(true)
			ImagePath="ui/hud/Tree.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Endurance)) IsInverted=@(true) ImagePath="ui/hud/shield.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Strength)) IsInverted=@(true) ImagePath="ui/hud/strength.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Agility)) IsInverted=@(true) ImagePath="ui/hud/running.png" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Intelligence)) IsInverted=@(true) ImagePath="ui/hud/brain.png" />

            
    </div>
    <h2 class="playe3">
        <div class="playe2"> Status Points</div> 
        <span class="nu">@Player.Local.StatsPoints</span>
    </h2>
    <div class="main">
        
        <div class="panel">
            
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Abilities ? 1 : 0)">
                <button class="panel-header-text"
                >Abilities</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Endurance ? 1 : 0)">
                <button class="panel-header-text" 
                    >Endurance</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Strength ? 1 : 0)">
                <button class="panel-header-text">Strength</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Agility ? 1 : 0)">
                <button class="panel-header-text">Agility</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Intelligence ? 1 : 0)">
                <button class="panel-header-text">Intelligence</button>
            </div>


            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Abilities ? 1 : 0)">
                
                    <div class="panel-content-text">
                        <p>Abilities</p>
                    </div>
            </div>
            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Endurance ? 1 : 0)">
                
                    <div class="panel-content-text">
                        <p>Endurance</p>
                    </div>
            </div>
            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Strength ? 1 : 0)">
                
                    <div class="panel-content-text">
                        <div class="panel-content-layout">
                            <div class="panel-button-layout"> 
                            <div class="box">
                                <p class="txt">Strength</p>
                                <div class="amount">@Player.Local.STG</div>
                                <button class="Button2" @onclick="@STGUpgrade">ATP+</button>
                                <div class="coast">Coast: @strengthCost</div>
                            </div>

                            <div class="box">
                                <p class="txt">Attack Power</p>
                                <div class="amount">@Player.Local.AttackPower</div>
                                <button class="Button2" @onclick="@AP">AP+</button>
                                <div class="coast">Coast: @attackPowerCost</div>
                            </div>
                            <div class="box">
                                <p class="txt">Armor Penetration</p>
                                <div class="amount">@Player.Local.ArmorPenetration</div>
                                <button class="Button2" @onclick="@ArmorPenetration">AP+</button>
                                <div class="coast">Coast: @armorPenetrationCost</div>
                            </div>
                            <div class="box">
                                <p class="txt">Attack Range</p>
                                <div class="amount">@Player.Local.AttackRange</div>
                                <button class="Button2" @onclick="@AttackRange">AR+</button>
                                <div class="coast">Coast: @attackRangeCost</div>
                            </div>
                            <div class="box">
                                <p class="txt">Attack Speed</p>
                                <div class="amount">@Math.Round(Player.Local.AttackSpeed)</div>
                                <button class="Button2" @onclick="@AttackSpeed">AS+</button>
                                <div class="coast">Coast: @attackSpeedCost</div>
                            </div>
                            <div class="box">
                                <p class="txt">Critical Chance</p>
                                <div class="amount">@Player.Local.CritHitChance</div>
                                <button class="Button2" @onclick="@CriticalChance">CC+</button>
                                <div class="coast">Coast: @criticalChanceCost</div>
                            </div>
                            <div class="box">
                                <p class="txt">Critical Damage</p>
                                <div class="amount">@Player.Local.CritHitDamage</div>
                                <button class="Button2" @onclick="@CriticalDamage">CD+</button>
                                <div class="coast">Coast: @criticalDamageCost</div>
                                            </div>
                        </div>
                        
                    </div>
                <div class="panel-content-context">
                    Information:
                </div>
            </div>   
            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Agility ? 1 : 0)">
                    
                        <div class="panel-content-text">
                            <p>Agility</p>
                        </div>
            </div>
            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Intelligence ? 1 : 0)">
                        <div class="panel-content-text">
                            <p>Intelligence</p>
                        </div>
            </div>
    </div>
        

    
        
    
</root>
@code{
    public static Abilities Instance { get; private set; }
    public Abilities() => Instance = this;
    public void Display()
    {
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.Abilities);
    }
    public void Hide()
    {
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud);
    }
    
   private enum PanelType
    {
        Abilities,
        Endurance,
        Strength,
        Agility,
        Intelligence
    }
    
    private PanelType currentPanel = PanelType.Abilities;
    
    private void ShowPanel(PanelType panel)
    {
        currentPanel = panel;
    }
    protected override int BuildHash()
    {

        if (Player.Local is null || Player.Local.Inventory == null)
            return -1;

        return HashCode.Combine(
        Player.Local.Level,
        Player.Local.Inventory.BackpackItems.HashCombine(i => i?.GetHashCode() ?? -1),
        Player.Local.Inventory.EquippedItems.HashCombine(i => i?.GetHashCode() ?? -1)
        );
    }
    public void AbilitiesChange()
    {
        StrengthCost = strengthCost;
        AttackPowerCost = attackPowerCost;
        ArmorPenetrationCost = armorPenetrationCost;
        AttackRangeCost = attackRangeCost;
        AttackSpeedCost = attackSpeedCost;
        CriticalChanceCost = criticalChanceCost;
        CriticalDamageCost = criticalDamageCost;
    }
    public int StrengthCost { get; set; }
    public int AttackPowerCost { get; set; }
    public int ArmorPenetrationCost { get; set; }
    public int AttackRangeCost { get; set; }
    public int AttackSpeedCost { get; set; }
    public int CriticalChanceCost { get; set; }
    public int CriticalDamageCost { get; set; }
    public int strengthCost = 1;
    public int attackPowerCost = 1;
    public int armorPenetrationCost = 1;
    public int attackRangeCost = 1;
    public int attackSpeedCost = 1;
    public int criticalChanceCost = 1;
    public  int criticalDamageCost  = 1;
    public void STGUpgrade()
    {
        if (Player.Local.StatsPoints >= StrengthCost)
        {
            
            Player.Local.STG += 1;
            Player.Local.Armor += 5;
            Player.Local.AttackPower += 5;
            if (Player.Local.PER > 0 && Player.Local.DEX < Player.Local.STG)
            {
                Player.Local.Block += Player.Local.PER;

            }
            if (Player.Local.Block != Player.Local.PER)
            {
                Player.Local.Block = Player.Local.PER;
                Player.Local.Evasion = 0;
            }

            if (Player.Local.STG % 4 == 0)
            {
                Player.Local.MaxStamina -= 2;
                Player.Local.PlayerRunSpeed -= 1;

            }
            if (Player.Local.STG % 8 == 0)
            {
                Player.Local.MagicPower -= 4;
                Player.Local.MagicDefense += 20;
            }
            if (Player.Local.STG % 20 == 0)
            {
                Player.Local.PER += 8;
                Player.Local.Tenacity += 10;
            }
            Player.Local.StatsPoints -= strengthCost;
            strengthCost++;
            

        }
    }
    public void AP()
    {
        if (Player.Local.StatsPoints >= attackPowerCost)
        {
            Player.Local.AttackPower += 5;
            Player.Local.StatsPoints -= attackPowerCost;
            attackPowerCost++;
        }
    }
    public void ArmorPenetration()
    {
        if (Player.Local.StatsPoints >= armorPenetrationCost)
        {
            Player.Local.ArmorPenetration += 5;
            Player.Local.StatsPoints -= armorPenetrationCost;
            armorPenetrationCost++;
        }
    }
    public void AttackRange()
    {
        if (Player.Local.StatsPoints >= attackRangeCost)
        {
            Player.Local.AttackRange += 5;
            Player.Local.StatsPoints -= attackRangeCost;
            attackRangeCost++;
        }
    }
    public void AttackSpeed()
    {
        if (Player.Local.StatsPoints >= attackSpeedCost)
        {
            Player.Local.AttackSpeed += 5;
            Player.Local.StatsPoints -= attackSpeedCost;
            attackSpeedCost++;
        }
    }
    public void CriticalChance()
    {
        if (Player.Local.StatsPoints >= criticalChanceCost)
        {
            Player.Local.CritHitChance += 5;
            Player.Local.StatsPoints -= criticalChanceCost;
            criticalChanceCost++;
        }
    }
    public void CriticalDamage()
    {
        if (Player.Local.StatsPoints >= criticalDamageCost)
        {
            Player.Local.CritHitDamage += 5;
            Player.Local.StatsPoints -= criticalDamageCost;
            criticalDamageCost++;
        }
    }
    
    
}