    private PanelType currentPanel = PanelType.Abilities;
    private PanelTypeText currentPanelText;
    
    private void ShowPanel(PanelType panel)
    {
        currentPanel = panel;
    }
    
    
    private void ShowPanelText(PanelTypeText panelText)
    {
        currentPanelText = panelText;
        StateHasChanged();
        Log.Info("Panel Text: " + GetPanelText(panelText));
        
    }
   
   
    
    public int StrengthCost { get; set; } = 5;
    public int AttackPowerCost { get; set; } = 1;
    public int ArmorPenetrationCost { get; set; } = 2;
    public int AttackRangeCost { get; set; } = 2;
    public int AttackSpeedCost { get; set; } = 1;
    public int CriticalChanceCost { get; set; } = 5;
    public int CriticalDamageCost { get; set; } = 3;
    private int EnduranceCost = 1;
    private int SlowResistanceCost = 1;
    private int BlindResistanceCost = 1;
    private int StunResistanceCost = 1;
    private int TenacityCost = 1;
    private int CoverCost = 1;
    private int MagicDefenseCost = 1;
    private int ArmorCost = 1;
    private int HealthCost = 1;
