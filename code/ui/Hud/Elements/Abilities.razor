@namespace GeneralGame.HUD
@inherits Panel
@attribute [StyleSheet]

<root>
    <SideButton
        Title="Exit"

        OnClick=@(() => FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud))
        IsInverted=@(true)
        ImagePath="ui/hud/exit.gif"
        style="position: absolute; top: 30px; right: 0px; z-index: 100;"
    />
    <SideButton
        Title="Inventory"

        OnClick=@(() => FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.Inventory))
        IsInverted=@(true)
        ImagePath="ui/hud/player.png"
        style="position: absolute; top: 150px; right: 0px; z-index: 100;"
    />

    <div class="sidehud">
        <SideButton OnClick=@(() => ShowPanel(PanelType.Abilities)) IsInverted=@(true)
            ImagePath="ui/hud/Tree.png" title="Abilities" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:blue; width:100%;" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Endurance)) IsInverted=@(true) ImagePath="ui/hud/shield.png" title="Endurance" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:green; width:100%;" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Strength)) IsInverted=@(true) ImagePath="ui/hud/strength.png" title="Strength" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:red; width:100%;" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Agility)) IsInverted=@(true) ImagePath="ui/hud/running.png" title="Agility" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:yellow; width:100%;" />
        <SideButton OnClick=@(() => ShowPanel(PanelType.Intelligence)) IsInverted=@(true) ImagePath="ui/hud/brain.png" title="Intelligence" TitleStyle="font-size:26px; position: relative; left: 100px; top: 50px; color:purple; width:100%;" />
    </div>

    <div class="stats-header">
        <span>Status Points</span>
        <span class="points-value">&#x2B50;@Player.Local.StatsPoints</span>
    </div>

    <div class="main">
        <div class="panel">

            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Abilities ? 1 : 0)">
                <button class="panel-header-text">Abilities</button>
                <p>Work In Progress</p>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Endurance ? 1 : 0)">
                <button class="panel-header-text">Endurance</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Strength ? 1 : 0)">
                <button class="panel-header-text">Strength</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Agility ? 1 : 0)">
                <button class="panel-header-text">Dexterity</button>
            </div>
            <div class="panel-header" style="opacity: @(currentPanel == PanelType.Intelligence ? 1 : 0)">
                <button class="panel-header-text">Intelligence</button>
            </div>

            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Endurance ? 1 : 0)">
                <div class="panel-content-text">
                    <div class="panel-content-layout">
                        <div class="panel-button-layout">
                            <div class="box" style="border-bottom-width: 2px; border-bottom-color: rgb(255, 255, 255); border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; font-weight: bold;">
                                <p class="txt" style="font-style: italic;">Endurance Stats</p>
                                <div class="amount" style="font-style: italic;">Player Stats</div>
                                <div class="coast" style="font-style: italic;">Stat Costs</div>
                                <button class="Button1" style="font-style: italic;">Upgrade</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Endurance))">
                                <p class="txt2">&#x1F330; Endurance</p>
                                <div class="amount">@Player.Local.PER</div>
                                <div class="coast">&#x2B50; @Player.Local.EnduranceCost</div>
                                <button class="Button2" @onclick="@EnduranceUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Health))">
                                <p class="txt">&#x2764;&#xFE0F; Health</p>
                                <div class="amount">@Player.Local.MaxHealth</div>
                                <div class="coast">&#x2B50; @Player.Local.HealthCost</div>
                                <button class="Button2" @onclick="@HealthUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Tenacity))">
                                <p class="txt">&#x26E8; Tenacity</p>
                                <div class="amount">@Player.Local.Tenacity</div>
                                <div class="coast">&#x2B50; @Player.Local.TenacityCost</div>
                                <button class="Button2" @onclick="@TenacityUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Cover))">
                                <p class="txt">&#x1F6E1;&#xFE0F; Cover</p>
                                <div class="amount">@Player.Local.Block</div>
                                <div class="coast">&#x2B50; @Player.Local.CoverCost</div>
                                <button class="Button2" @onclick="@CoverUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.MagicDefense))">
                                <p class="txt">&#x2728; Magic Defense</p>
                                <div class="amount">@Player.Local.MagicDefense</div>
                                <div class="coast">&#x2B50; @Player.Local.MagicDefenseCost</div>
                                <button class="Button2" @onclick="@MagicDefenseUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Armor))">
                                <p class="txt">&#x1F9E3; Armor</p>
                                <div class="amount">@Player.Local.Armor</div>
                                <div class="coast">&#x2B50; @Player.Local.ArmorCost</div>
                                <button class="Button2" @onclick="@ArmorUpgrade">+</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-content-context">
                    <p class="head">Information:</p>
                    <p class="text">@GetPanelText(currentPanelText)</p>
                    <p class="text2">@GetPanelText2(currentPanelText)</p>
                </div>
            </div>

            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Strength ? 1 : 0)">
                <div class="panel-content-text">
                    <div class="panel-content-layout">
                        <div class="panel-button-layout">
                            <div class="box" style="border-bottom-width: 2px; border-bottom-color: rgb(255, 255, 255); border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; font-weight: bold;">
                                <p class="txt" style="font-style: italic;">Strength Stats</p>
                                <div class="amount" style="font-style: italic;">Player Stats</div>
                                <div class="coast" style="font-style: italic;">Stat Costs</div>
                                <button class="Button1" style="font-style: italic;">Upgrade</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Strength))">
                                <p class="txt2">&#x1F4AA; Strength</p>
                                <div class="amount">@Player.Local.STG</div>
                                <div class="coast">&#x2B50; @Player.Local.StrengthCost</div>
                                <button class="Button2" @onclick="@STGUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.AttackPower))">
                                <p class="txt">&#x1F499; Attack Power</p>
                                <div class="amount">@Player.Local.AttackPower</div>
                                <div class="coast">&#x2B50; @Player.Local.AttackPowerCost</div>
                                <button class="Button2" @onclick="@AP">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.ArmorPenetration))">
                                <p class="txt">&#x1F52F; Armor Penetration</p>
                                <div class="amount">@Player.Local.ArmorPenetration</div>
                                <div class="coast">&#x2B50; @Player.Local.ArmorPenetrationCost</div>
                                <button class="Button2" @onclick="@ArmorPenetration">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.AttackRange))">
                                <p class="txt">&#x1F4D0; Attack Range</p>
                                <div class="amount">@Player.Local.AttackRange</div>
                                <div class="coast">&#x2B50; @Player.Local.AttackRangeCost</div>
                                <button class="Button2" @onclick="@AttackRange">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.AttackSpeed))">
                                <p class="txt">&#x2702;&#xFE0F; Attack Speed</p>
                                <div class="amount">@Math.Round(Player.Local.AttackSpeed)</div>
                                <div class="coast">&#x2B50; @Player.Local.AttackSpeedCost</div>
                                <button class="Button2" @onclick="@AttackSpeed">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.CriticalChance))">
                                <p class="txt">&#x1F3AF; Critical Chance</p>
                                <div class="amount">@Player.Local.CritHitChance</div>
                                <div class="coast">&#x2B50; @Player.Local.CriticalChanceCost</div>
                                <button class="Button2" @onclick="@CriticalChance">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.CriticalDamage))">
                                <p class="txt">&#x1F4A5; Critical Damage</p>
                                <div class="amount">@Player.Local.CritHitDamage</div>
                                <div class="coast">&#x2B50; @Player.Local.CriticalDamageCost</div>
                                <button class="Button2" @onclick="@CriticalDamage">+</button>
                            </div>
                        </div>
                    </div>
                    <div class="panel-content-context">
                        <p class="head">Information:</p>
                        <p class="text">@GetPanelText(currentPanelText)</p>
                        <p class="text2">@GetPanelText2(currentPanelText)</p>
                    </div>
                </div>
            </div>

            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Agility ? 1 : 0)">
                <div class="panel-content-text">
                    <div class="panel-content-layout">
                        <div class="panel-button-layout">
                            <div class="box" style="border-bottom-width: 2px; border-bottom-color: rgb(255, 255, 255); border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; font-weight: bold;">
                                <p class="txt" style="font-style: italic;">Dexterity Stats</p>
                                <div class="amount" style="font-style: italic;">Player Stats</div>
                                <div class="coast" style="font-style: italic;">Stat Costs</div>
                                <button class="Button1" style="font-style: italic;">Upgrade</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Dexterity))">
                                <p class="txt">&#x1F3C3; Dexterity</p>
                                <div class="amount">@Player.Local.DEX</div>
                                <div class="coast">&#x2B50; @Player.Local.DexterityCost</div>
                                <button class="Button2" @onclick="@DexterityUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Mana))">
                                <p class="txt">&#x1F52E; Mana</p>
                                <div class="amount">@Player.Local.MaxMana</div>
                                <div class="coast">&#x2B50; @Player.Local.ManaCost</div>
                                <button class="Button2" @onclick="@ManaUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Evasion))">
                                <p class="txt">&#x1F300; Evasion</p>
                                <div class="amount">@Player.Local.Evasion</div>
                                <div class="coast">&#x2B50; @Player.Local.EvasionCost</div>
                                <button class="Button2" @onclick="@EvasionUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.AbilityHaste))">
                                <p class="txt">&#x23F1;&#xFE0F; Ability Haste</p>
                                <div class="amount">@Player.Local.AbilityHaste</div>
                                <div class="coast">&#x2B50; @Player.Local.AbilityHasteCost</div>
                                <button class="Button2" @onclick="@AbilityHasteUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Stamina))">
                                <p class="txt">&#x1F4AA; Stamina</p>
                                <div class="amount">@Player.Local.MaxStamina</div>
                                <div class="coast">&#x2B50; @Player.Local.StaminaCost</div>
                                <button class="Button2" @onclick="@StaminaUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.PlayerWalkSpeed))">
                                <p class="txt">&#x1F6B6; Walk Speed</p>
                                <div class="amount">@Player.Local.PlayerWalkSpeed</div>
                                <div class="coast">&#x2B50; @Player.Local.PlayerWalkSpeedCost</div>
                                <button class="Button2" @onclick="@PlayerWalkSpeedUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.PlayerRunSpeed))">
                                <p class="txt">&#x1F3C3; Run Speed</p>
                                <div class="amount">@Player.Local.PlayerRunSpeed</div>
                                <div class="coast">&#x2B50; @Player.Local.PlayerRunSpeedCost</div>
                                <button class="Button2" @onclick="@PlayerRunSpeedUpgrade">+</button>
                            </div>
                        </div>
                    </div>
                    <div class="panel-content-context">
                        <p class="head">Info</p>
                        <p class="text">@GetPanelText(currentPanelText)</p>
                        <p class="text2">@GetPanelText2(currentPanelText)</p>
                    </div>
                </div>
            </div>

            <div class="panel-content" style="opacity: @(currentPanel == PanelType.Intelligence ? 1 : 0)">
                <div class="panel-content-text">
                    <div class="panel-content-layout">
                        <div class="panel-button-layout">
                            <div class="box" style="border-bottom-width: 2px; border-bottom-color: rgb(255, 255, 255); border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; font-weight: bold;">
                                <p class="txt" style="font-style: italic;">Intelligence Stats</p>
                                <div class="amount" style="font-style: italic;">Player Stats</div>
                                <div class="coast" style="font-style: italic;">Stat Costs</div>
                                <button class="Button1" style="font-style: italic;">Upgrade</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.Intelligence))">
                                <p class="txt">&#x1F9E0; Intelligence</p>
                                <div class="amount">@Player.Local.INT</div>
                                <div class="coast">&#x2B50; @Player.Local.IntelligenceCost</div>
                                <button class="Button2" @onclick="@INTUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.MagicPower))">
                                <p class="txt">&#x1F52E; Magic Power</p>
                                <div class="amount">@Player.Local.MagicPower</div>
                                <div class="coast">&#x2B50; @Player.Local.MagicPowerCost</div>
                                <button class="Button2" @onclick="@MagicPowerUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.MagicPenetration))">
                                <p class="txt">&#x1F384; Magic Penetration</p>
                                <div class="amount">@Player.Local.MagicPenetration</div>
                                <div class="coast">&#x2B50; @Player.Local.MagicPenetrationCost</div>
                                <button class="Button2" @onclick="@MagicPenetrationUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.BonusEXPGain))">
                                <p class="txt">&#x1F4C8; Bonus EXP</p>
                                <div class="amount">@Player.Local.BonusEXPGain.ToString("F2")</div>
                                <div class="coast">&#x2B50; @Player.Local.BonusEXPGainCost</div>
                                <button class="Button2" @onclick="@BonusEXPGainUpgrade">+</button>
                            </div>
                            <div class="box" @onmouseover="@(() => ShowPanelText(PanelTypeText.BonusVyndaliumGain))">
                                <p class="txt">&#x1F48E; Bonus $</p>
                                <div class="amount">@Player.Local.BonusVyndalium</div>
                                <div class="coast">&#x2B50; @Player.Local.BonusVyndaliumGainCost</div>
                                <button class="Button2" @onclick="@BonusVyndaliumGainUpgrade">+</button>
                            </div>
                        </div>
                    </div>
                    <div class="panel-content-context">
                        <p class="head">Information:</p>
                        <p class="text">@GetPanelText(currentPanelText)</p>
                        <p class="text2">@GetPanelText2(currentPanelText)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</root>
@code{
    public override void Tick()
    {
        StateHasChanged();
    }

    public static Abilities Instance { get; private set; }
    public Abilities() => Instance = this;
    public void Display()
    {
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.Abilities);
    }
    public void Hide()
    {
        FullScreenManager.Instance.Display(FullScreenManager.FullScreenPanel.InGameHud);
    }

    private enum PanelType
    {
        Abilities,
        Endurance,
        Strength,
        Agility,
        Intelligence
    }
    private enum PanelTypeText
    {
        Strength,
        AttackPower,
        ArmorPenetration,
        AttackRange,
        AttackSpeed,
        CriticalChance,
        CriticalDamage,
        Endurance,
        SlowResistance,
        BlindResistance,
        StunResistance,
        Tenacity,
        Cover,
        MagicDefense,
        Armor,
        Health,
        Dexterity,
        Evasion,
        AbilityHaste,
        Stamina,
        PlayerWalkSpeed,
        PlayerRunSpeed,
        Mana,
        Intelligence,
        MagicPower,
        MagicPenetration,
        BonusEXPGain,
        BonusVyndaliumGain
    }
    private string GetPanelText(PanelTypeText panelText)
    {
        return panelText switch
        {
            PanelTypeText.Strength => "Strength increases your physical power and allows you to carry heavier items.",
            PanelTypeText.AttackPower => "Attack Power boosts your damage output.",
            PanelTypeText.ArmorPenetration => "Armor Penetration allows you to bypass enemy defenses.",
            PanelTypeText.AttackRange => "Attack Range extends the distance you can hit enemies.",
            PanelTypeText.AttackSpeed => "Attack Speed increases the rate at which you can attack.",
            PanelTypeText.CriticalChance => "Critical Chance increases the likelihood of landing critical hits.",
            PanelTypeText.CriticalDamage => "Critical Damage boosts the damage of your critical hits.",
            PanelTypeText.Endurance => "Endurance increases your stamina and allows you to perform actions for longer periods.",
            PanelTypeText.SlowResistance => "Slow Resistance reduces the effect of slowing debuffs on you.",
            PanelTypeText.BlindResistance => "Blind Resistance reduces the effect of blinding debuffs on you.",
            PanelTypeText.StunResistance => "Stun Resistance reduces the effect of stunning debuffs on you.",
            PanelTypeText.Tenacity => "Tenacity reduces the duration of crowd control effects on you.",
            PanelTypeText.Cover => "Cover increases your defense when taking cover.",
            PanelTypeText.MagicDefense => "Magic Defense reduces the damage taken from magical attacks.",
            PanelTypeText.Armor => "Armor reduces the damage taken from physical attacks.",
            PanelTypeText.Health => "Health increases your maximum hit points.",
            PanelTypeText.Dexterity => "Dexterity improves your agility and reflexes.",
            PanelTypeText.Evasion => "Evasion increases your chance to dodge attacks.",
            PanelTypeText.AbilityHaste => "Ability Haste reduces the cooldown of your abilities.",
            PanelTypeText.Stamina => "Stamina increases your endurance and energy.",
            PanelTypeText.PlayerWalkSpeed => "Player Walk Speed increases your walking speed.",
            PanelTypeText.PlayerRunSpeed => "Player Run Speed increases your running speed.",
            PanelTypeText.Mana => "Mana is used to cast spells and abilities.",
            PanelTypeText.Intelligence => "Intelligence increases your magical power and knowledge.",
            PanelTypeText.MagicPower => "Magic Power boosts the damage of your magical attacks.",
            PanelTypeText.MagicPenetration => "Magic Penetration allows you to bypass enemy magical defenses.",
            PanelTypeText.BonusEXPGain => "Bonus EXP Gain increases the amount of experience points you earn.",
            PanelTypeText.BonusVyndaliumGain => "Bonus Vyndalium Gain increases the amount of Vyndalium you earn.",
            _ => "Unknown ability."
        };
    }
    private string GetPanelText2(PanelTypeText panelText)
    {
        return panelText switch
        {
            PanelTypeText.Strength => "| STG + 1 | Armor + 5 | AttackPower + 5 |",
            PanelTypeText.AttackPower => "| Attack Power + 5 |",
            PanelTypeText.ArmorPenetration => "| Armor Penetration + 5 |",
            PanelTypeText.AttackRange => "| Attack Range + 5 |",
            PanelTypeText.AttackSpeed => "| Attack Speed + 5 |",
            PanelTypeText.CriticalChance => "| Critical Chance + 5% |",
            PanelTypeText.CriticalDamage => "| Critical Damage + 5 |",
            PanelTypeText.Endurance => "| Endurance + 1 |",
            PanelTypeText.SlowResistance => "| Slow Resistance + 1 |",
            PanelTypeText.BlindResistance => "| Blind Resistance + 1 |",
            PanelTypeText.StunResistance => "| Stun Resistance + 1 |",
            PanelTypeText.Tenacity => "| Tenacity + 1 |",
            PanelTypeText.Cover => "| Cover + 1 |",
            PanelTypeText.MagicDefense => "| Magic Defense + 5 |",
            PanelTypeText.Armor => "| Armor + 5 |",
            PanelTypeText.Health => "| Health + 10 |",
            PanelTypeText.Dexterity => "| Dexterity + 3 |",
            PanelTypeText.Evasion => "| Evasion + 4 |",
            PanelTypeText.AbilityHaste => "| Ability Haste + 5 |",
            PanelTypeText.Stamina => "| Stamina + 6 |",
            PanelTypeText.PlayerWalkSpeed => "| Player Walk Speed + 14 |",
            PanelTypeText.PlayerRunSpeed => "| Player Run Speed + 18 |",
            PanelTypeText.Mana => "| Mana + 9 |",
            PanelTypeText.Intelligence => "| Intelligence + 1 |",
            PanelTypeText.MagicPower => "| Magic Power + 2 |",
            PanelTypeText.MagicPenetration => "| Bonus EXP Gain + 15% |",
            PanelTypeText.BonusEXPGain => "| Bonus EXP Gain + 15% |",
            PanelTypeText.BonusVyndaliumGain => "| Bonus Vyndalium Gain + 0,3 |",
            _ => "| Unknown panel text. |"
        };
    }
    private PanelType currentPanel = PanelType.Endurance;
    private PanelTypeText currentPanelText;

    private void ShowPanel(PanelType panel)
    {
        currentPanel = panel;
    }

    private void ShowPanelText(PanelTypeText panelText)
    {
        currentPanelText = panelText;
        StateHasChanged();
    }

    public void STGUpgrade()
    {
        if (Player.Local.StatsPoints >= Player.Local.StrengthCost)
        {
            Player.Local.STG += 1;
            Player.Local.Armor += 5;
            Player.Local.AttackPower += 15;
            if (Player.Local.PER > 0 && Player.Local.DEX < Player.Local.STG)
            {
                Player.Local.Block += Player.Local.PER;
            }
            if (Player.Local.Block != Player.Local.PER)
            {
                Player.Local.Block = Player.Local.PER;
                Player.Local.Evasion = 0;
            }
            if (Player.Local.STG % 4 == 0)
            {
                Player.Local.MaxStamina -= 2;
                Player.Local.PlayerRunSpeed -= 1;
            }
            if (Player.Local.STG % 8 == 0)
            {
                Player.Local.MagicPower -= 4;
                Player.Local.MagicDefense += 20;
            }
            if (Player.Local.STG % 20 == 0)
            {
                Player.Local.PER += 8;
                Player.Local.Tenacity += 10;
            }
            Player.Local.StatsPoints -= Player.Local.StrengthCost;
            Player.Local.StrengthCost++;
            Hudmaster.Instance.ShowNotification("Attack Power +", "/ui/hud/success.gif");
            Player.Local.PlaySuccessSoundFromPath("sounds/upgrade/success.sound", 0.15f);
        }
    }

    public void AP()
    {
        if (Player.Local.StatsPoints >= Player.Local.AttackPowerCost)
        {
            Player.Local.AttackPower += 25;
            Player.Local.StatsPoints -= Player.Local.AttackPowerCost;
            Player.Local.AttackPowerCost++;
            Hudmaster.Instance.ShowNotification("Attack Power +", "/ui/hud/success.gif");
            Player.Local.PlaySuccessSoundFromPath("sounds/upgrade/success.sound", 0.15f);
        }
    }
    public void ArmorPenetration()
    {
        if (Player.Local.StatsPoints >= Player.Local.ArmorPenetrationCost)
        {
