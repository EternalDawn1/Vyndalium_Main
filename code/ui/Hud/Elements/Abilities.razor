        AttackPower,
        ArmorPenetration,
        AttackRange,
        AttackSpeed,
        CriticalChance,
        CriticalDamage,


// Endurance         
        Endurance,
        SlowResistance,
        BlindResistance,
        StunResistance,
        Tenacity,
        Cover,
        MagicDefense,
        Armor,
        Health,

        // Agility
        Dexterity,
        Evasion,
        AbilityHaste,
        Stamina,
        PlayerWalkSpeed,
        PlayerRunSpeed,
        Mana,
        // Intelligence
        Intelligence,
        MagicPower,
        MagicPenetration,
        BonusEXPGain,
        BonusVyndaliumGain

    }
    private string GetPanelText(PanelTypeText panelText)
    {
        return panelText switch
        {
            PanelTypeText.Strength => "Strength increases your physical power and allows you to carry heavier items.",
            PanelTypeText.AttackPower => "Attack Power boosts your damage output.",
            PanelTypeText.ArmorPenetration => "Armor Penetration allows you to bypass enemy defenses.",
            PanelTypeText.AttackRange => "Attack Range extends the distance you can hit enemies.",
            PanelTypeText.AttackSpeed => "Attack Speed increases the rate at which you can attack.",
            PanelTypeText.CriticalChance => "Critical Chance increases the likelihood of landing critical hits.",
            PanelTypeText.CriticalDamage => "Critical Damage boosts the damage of your critical hits.",
            PanelTypeText.Endurance => "Endurance increases your stamina and allows you to perform actions for longer periods.",
            PanelTypeText.SlowResistance => "Slow Resistance reduces the effect of slowing debuffs on you.",
            PanelTypeText.BlindResistance => "Blind Resistance reduces the effect of blinding debuffs on you.",
            PanelTypeText.StunResistance => "Stun Resistance reduces the effect of stunning debuffs on you.",
            PanelTypeText.Tenacity => "Tenacity reduces the duration of crowd control effects on you.",
            PanelTypeText.Cover => "Cover increases your defense when taking cover.",
            PanelTypeText.MagicDefense => "Magic Defense reduces the damage taken from magical attacks.",
            PanelTypeText.Armor => "Armor reduces the damage taken from physical attacks.",
            PanelTypeText.Health => "Health increases your maximum hit points.",
            PanelTypeText.Dexterity => "Dexterity improves your agility and reflexes.",
            PanelTypeText.Evasion => "Evasion increases your chance to dodge attacks.",
            PanelTypeText.AbilityHaste => "Ability Haste reduces the cooldown of your abilities.",
            PanelTypeText.Stamina => "Stamina increases your endurance and energy.",
            PanelTypeText.PlayerWalkSpeed => "Player Walk Speed increases your walking speed.",
            PanelTypeText.PlayerRunSpeed => "Player Run Speed increases your running speed.",
            PanelTypeText.Mana => "Mana is used to cast spells and abilities.",
            PanelTypeText.Intelligence => "Intelligence increases your magical power and knowledge.",
            PanelTypeText.MagicPower => "Magic Power boosts the damage of your magical attacks.",
            PanelTypeText.MagicPenetration => "Magic Penetration allows you to bypass enemy magical defenses.",
            PanelTypeText.BonusEXPGain => "Bonus EXP Gain increases the amount of experience points you earn.",
            PanelTypeText.BonusVyndaliumGain => "Bonus Vyndalium Gain increases the amount of Vyndalium you earn.",
            
            
            _ => "Unknown ability."
        };
    }
    private string GetPanelText2(PanelTypeText panelText)
    {
        return panelText switch
        {
            PanelTypeText.Strength => "| STG + 1 | Armor + 5 | AttackPower + 5 |",
            PanelTypeText.AttackPower => "| Attack Power + 5 |",
            PanelTypeText.ArmorPenetration => "| Armor Penetration + 5 |",
