    public int EvasionCost { get; set; } = 4;
    public int AbilityHasteCost { get; set; } = 5;
    public int StaminaCost { get; set; } = 6;
    public int PlayerWalkSpeedCost { get; set; } = 7;
    public int PlayerRunSpeedCost { get; set; } = 8;
    public int ManaCost { get; set; } = 9;
