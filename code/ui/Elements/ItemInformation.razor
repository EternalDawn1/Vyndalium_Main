@namespace GeneralGame.HUD
@attribute [StyleSheet]
@inherits Panel
@if (Item != null)
{
	<root class="@($"background {GetTierClass(Item.Tier)}")"
		style="@($"opacity: {GetOpacityBasedOnLevel(Item.ItemLevel)}")">
		<div class="item-details">
			<div class="top-row">
				<text class="item-name-top" style="justify-content: center; align-items: center;">@Item.Name</text>
				<div class="item-name"
					style="position: absolute; left: 5%; align-items: center; justify-content: center; top: -4%;">
					<h2 class="tier @Item.Tier.ToString()">@Item.Tier</h2>
				</div>
				@if (!Item.IsMaterial && !Item.IsPotion)
				{
					<div class="item-name"
						style="position: absolute; right: 0%; align-items: center; justify-content: center; top: 0%;">
						<h2 class="lvl @GetLevelColor(Item.ItemLevel)">+@Item.ItemLevel</h2>
					</div>
				}
				<div style="flex-direction: column; align-items: flex-end; gap: 2px;"></div>
				@if (FullScreenManager.Instance.ActivePanel == FullScreenManager.FullScreenPanel.ShopPanel &&
						ShopPanel.Instance.currentPanel == ShopPanel.PanelType.Accessories)
				{
					<div class="item-price">$@($"{Item.BuyPrice:N0}") <p class="item-price-name"></p>
					</div>
				}
				else if (Item != null || ShopPanel.Instance.currentPanel != ShopPanel.PanelType.Accessories)
				{
					<div class="item-price2">
						<text> 1x $@($"{Item.SellPrice:N0}") </text>
						@if (Item.Count > 1)
						{
							<text>@(Item.Count)x $@($"{CalculateTotalSellPrice(Item):N0}")</text>
							<br />
						}
						<p class="item-price-name"></p>
					</div>
				}
				@if (Item.Aspect != AspectType.None)
				{
					<div class="aspect-description" style="color: @GetAspectColor(Item.Aspect)">
						<text>Aspect: @Item.GetAspectAsString()</text>
					</div>
				}
				<div class="description"
					style="justify-content: center;@(!string.IsNullOrEmpty(Item.Description) ? "align-items: center;" : "")">
				</div>
			</div>

			@if (Item.RequiredLevel > 0)
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">
					From Level: @Item.RequiredLevel
				</div>
			}
			@if (!string.IsNullOrEmpty(Item.Description))
			{
				<div class="@(IsLevelSufficient ? "item-description" : "item-description insufficient-level")">
					@Item.Description</div>
			}
			@if (Item is HealthPotion healthPotion)
			{
				<div class="@(IsLevelSufficient ? "item-description" : "item-description1 insufficient-level")">Heals:
					@healthPotion.HealthAmount HP</div>
			}
			@if(Item is Backpack backpack)
			{
				<div class="@(IsLevelSufficient ? "item-description" : "item-description1 insufficient-level")">Backpack
					Slots: @backpack.SlotAmount</div>
			}
			@if (Item.MinAttackValue != default(int) && Item.MaxAttackValue != default(int))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">
					<p class="y">Attack Value:</p>
					<p class="x">@Item.MinAttackValue - @Item.MaxAttackValue</p>
				</div>
			}
			@if(Item.MinArmorValue != default(int) && Item.MaxArmorValue != default(int))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">
					<p class="y1">Armor Value:</p>
					<p class="x">@Item.MinArmorValue - @Item.MaxArmorValue</p>
				</div>
			}
			@if (Item.STG != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">STG: +@Item.STG
				</div>
			}
			@if (Item.HE != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">HP+: +@Item.HE
				</div>
			}
			@if (Item.DEX != default(int))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">DEX: +@Item.DEX
				</div>
			}
			@if (Item.PER != default(int))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">PER: +@Item.PER
				</div>
			}
			@if (Item.INT != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">INT: +@Item.INT
				</div>
			}
			@if (Item.Mana != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Mana: +@Item.Mana
				</div>
			}
			@if (Item.Health != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Health:
					+@Item.Health</div>
			}
			@if (Item.CritHitDamage != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Crit Hit Damage:
					+@Item.CritHitDamage</div>
			}
			@if (Item.CritHitChance != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Crit Hit Chance:
					+@Item.CritHitChance</div>
			}
			@if (Item.AbilityHaste != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Ability Haste:
					+@Item.AbilityHaste</div>
			}
			@if (Item.AttackPower != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Attack Power:
					+@Item.AttackPower</div>
			}
			@if (Item.DamageBalance != default(int))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Damage Balance:
					+@Item.DamageBalance</div>
			}
			@if (Item.Durability != default(int))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Durability:
					+@Item.Durability</div>
			}
			@if (Item.AttackSpeed != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Attack Speed:
					+@Item.AttackSpeed</div>
			}
			@if (Item.MoveSpeed != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Move Speed:
					+@Item.MoveSpeed</div>
			}
			@if (Item.MagicPower != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Magic Power:
					+@Item.MagicPower</div>
			}
			@if (Item.Armor != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Armor:
					+@Item.Armor</div>
			}
			@if (Item.MagicDefense != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Magic Defense:
					+@Item.MagicDefense</div>
			}
			@if (Item.Evasion != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Evasion:
					+@Item.Evasion</div>
			}
			@if (Item.Cover != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Cover:
					+@Item.Cover</div>
			}
			@if (Item.BonusEXP != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Bonus EXP:
					+@Item.BonusEXP</div>
			}
			@if (Item.BonusScore != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Bonus Score:
					+@Item.BonusScore</div>
			}
			@if (Item.BonusVyndalium != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Bonus Vyndalium:
					+@Item.BonusVyndalium</div>
			}
			@if (Item.Tenacity != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Tenacity:
					+@Item.Tenacity</div>
			}
			@if (Item.StunResistance != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Stun Resistance:
					+@Item.StunResistance</div>
			}
			@if (Item.BlindResistance != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Blind Resistance:
					+@Item.BlindResistance</div>
			}
			@if (Item.SlowResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Slow Resistance:
					+@Item.SlowResistence</div>
			}
			@if (Item.FireResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Fire Resistance:
					+@Item.FireResistence</div>
			}
			@if (Item.BleedResistance != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Bleed Resistance:
					+@Item.BleedResistance</div>
			}
			@if (Item.PoisonResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Poison
					Resistance: +@Item.PoisonResistence</div>
			}
			@if (Item.IceResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Ice Resistance:
					+@Item.IceResistence</div>
			}
			@if (Item.LightningResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Lightning
					Resistance: +@Item.LightningResistence</div>
			}
			@if (Item.HolyResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Holy Resistance:
					+@Item.HolyResistence</div>
			}
			@if(Item.ShadowResistence != default(float))
			{
				<div class="@(IsLevelSufficient ? "item-description1" : "item-description1 insufficient-level")">Shadow Resistance:
					+@Item.ShadowResistence</div>
			}
		</div>
	</root>
}


@code
{
	public ItemComponent Item { get; set; }
	public WeaponComponent Weapon { get; set; }
	private bool IsLevelSufficient => Player.Local.Level >= Item.RequiredLevel;
	private int CalculateTotalSellPrice(ItemComponent item)
	{
		return item.SellPrice * item.Count;
	}
	private string GetAspectColor(AspectType aspect)
	{
		return aspect switch
		{
			AspectType.Fire => "red",
			AspectType.Water => "blue",
			AspectType.Earth => "green",
			AspectType.Air => "gray",
			AspectType.Ice => "lightblue",
			AspectType.Shadow => "purple",
			AspectType.Holy => "yellow",
			AspectType.Bleed => "darkred",
			AspectType.Poison => "darkgreen",
			_ => "black" // Standardfarbe
		};
	}
	private string GetTierClass(GeneralGame.Tier tier)
	{
		return tier switch
		{
			GeneralGame.Tier.C => "tier-c",
			GeneralGame.Tier.B => "tier-b",
			GeneralGame.Tier.A => "tier-a",
			GeneralGame.Tier.S => "tier-s",
			GeneralGame.Tier.SS => "tier-ss",
			GeneralGame.Tier.SSS => "tier-sss",
			GeneralGame.Tier.Ultimate => "tier-ultimate",
			_ => string.Empty
		};
	}
	private string GetOpacityBasedOnLevel(float level)
	{
		// Berechne die Opazität basierend auf dem Level, wobei Level 27 eine Opazität von 1.0 ergibt
		float opacity = level / 27;
		// Stelle sicher, dass die Opazität mindestens 0.1 beträgt
		opacity = Math.Max(opacity, 0.1f);
		return opacity.ToString("0.0");
	}

	private string GetLevelColor(float level)
	{

		switch (level)
		{
			case 0: return "level-color-0";
			case 1: return "level-color-1";
			case 2: return "level-color-2";
			case 3: return "level-color-3";
			case 4: return "level-color-4";
			case 5: return "level-color-5";
			case 6: return "level-color-6";
			case 7: return "level-color-7";
			case 8: return "level-color-8";
			case 9: return "level-color-9";
			case 10: return "level-color-10";
			case 11: return "level-color-11";
			case 12: return "level-color-12";
			case 13: return "level-color-13";
			case 14: return "level-color-14";
			case 15: return "level-color-15";
			case 16: return "level-color-16";
			case 17: return "level-color-17";
			case 18: return "level-color-18";
			case 19: return "level-color-19";
			case 20: return "level-color-20";
			case 21: return "level-color-21";
			case 22: return "level-color-22";
			case 23: return "level-color-23";
			case 24: return "level-color-24";
			case 25: return "level-color-25";
			case 26: return "gold-color"; // Hellste Farbe vor Gold
			case 27: return "black-color"; // Gold für das 27. Level
			default: return "black-color"; // Für andere Fälle
		}
	}
	protected override int BuildHash()
	{
		if (Player.Local is null)
			return -1;

		return HashCode.Combine(
		Item.Tier,
		Item.ItemLevel


		);
	}

}
