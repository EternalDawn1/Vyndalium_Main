@using Sandbox;
@using Sandbox.UI;

@namespace GeneralGame
@inherits PanelComponent
@attribute [StyleSheet]

<root>
	<img src=@Icon?.ResourcePath />
</root>

@code {
	[Property]public Texture Icon { get; set; }

	protected override int BuildHash()
	{
		return HashCode.Combine( Icon?.ResourcePath );
	}
}
