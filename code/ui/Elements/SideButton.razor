@namespace GeneralGame.HUD
@attribute [StyleSheet]
@inherits Panel

@foreach (var player in Scene.GetAllComponents<Player>())
    {
        if (player == null || !player.IsValid())
        {
            continue;
        }
		
	}

<root 
	onclick=@(() => { if (!IsDisabled) OnClick?.Invoke(); })
	class="@(IsDisabled ? "disabled" : "") @(IsInverted ? "ltr" : "")"
>
	<image src=@ImagePath />
	<div class="text-container">
		@if (!string.IsNullOrEmpty(TitleStyle))
		{
			<text class="text-title" style="@TitleStyle">@Title</text>
		}
		else
		{
			<text class="text-title">@Title</text>
		}
		@if (!string.IsNullOrEmpty(SubtitleStyle))
		{
			<text class="text-subtitle" style="@SubtitleStyle">@Subtitle</text>
		}
		else
		{
			<text class="text-subtitle">@Subtitle</text>
		}
	</div>
</root>

@code {
	public string Title { get; set; }
	public string Subtitle { get; set; }
	public string ImagePath { get; set; }
	public bool IsDisabled { get; set; } = false;
	public bool IsInverted { get; set; } = false;
	new public Action OnClick { get; set; }
	public string SubtitleStyle { get; set; }
	public string TitleStyle { get; set; }
	protected override int BuildHash()
	{
		return HashCode.Combine(IsDisabled, IsInverted);
	}
}
