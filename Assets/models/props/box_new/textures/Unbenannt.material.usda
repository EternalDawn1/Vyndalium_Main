                    float2 inputs:st.connect = </RootNode/material/Safety_top_bottom/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "occlusionTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </RootNode/material/Safety_top_bottom.inputs:compositedAmbientOcclusion_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RootNode/material/Safety_top_bottom/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normalTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, 1, -1, 0)
                    asset inputs:file.connect = </RootNode/material/Safety_top_bottom.inputs:compositedNormalDX_tex>
                    float4 inputs:scale = (2, -2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RootNode/material/Safety_top_bottom/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
            }
        }

        def Material "Safety_middle"
        {
            asset inputs:basecolor_tex = @Unbenannt_textures/Safety_middle_Base_color.png@
            asset inputs:compositedAmbientOcclusion_tex = @Unbenannt_textures/Safety_middle_Mixed_AO.png@
            asset inputs:compositedNormalDX_tex = @Unbenannt_textures/Safety_middle_Normal_DirectX.png@
            asset inputs:height_tex = @Unbenannt_textures/Safety_middle_Height.png@
            asset inputs:metallic_tex = @Unbenannt_textures/Safety_middle_Metallic.png@
            asset inputs:normal_tex = @Unbenannt_textures/Safety_middle_Normal.png@
            asset inputs:roughness_tex = @Unbenannt_textures/Safety_middle_Roughness.png@
            token outputs:displacement.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/UsdPreviewSurfaceShader.outputs:displacement>
            token outputs:surface.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/UsdPreviewSurfaceShader.outputs:surface>

            def NodeGraph "UsdPreviewSurface"
            {
                def Shader "UsdPreviewSurfaceShader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float3 inputs:diffuseColor.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/diffuseColorTextureShader.outputs:rgb>
                    float inputs:metallic.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/metallicTextureShader.outputs:r>
                    normal3f inputs:normal.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/normalTextureShader.outputs:rgb>
                    float inputs:occlusion.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/occlusionTextureShader.outputs:r>
                    float inputs:roughness.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/roughnessTextureShader.outputs:r>
                    token outputs:displacement
                    token outputs:surface
                }

                def Shader "TexCoordReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "diffuseColorTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </RootNode/material/Safety_middle.inputs:basecolor_tex>
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "roughnessTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </RootNode/material/Safety_middle.inputs:roughness_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "metallicTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </RootNode/material/Safety_middle.inputs:metallic_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "occlusionTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </RootNode/material/Safety_middle.inputs:compositedAmbientOcclusion_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normalTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, 1, -1, 0)
                    asset inputs:file.connect = </RootNode/material/Safety_middle.inputs:compositedNormalDX_tex>
                    float4 inputs:scale = (2, -2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </RootNode/material/Safety_middle/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
            }
        }
    }

    over "group"
    {
        over "Metin2___Full_Moon_Sword1_scene"
        {
            over "Metin2___Full_Moon_Sword1_Meshes"
            {
                over "Metin2___Full_Moon_Sword1_Sketchfab_model"
                {
                    over "Metin2___Full_Moon_Sword1_root"
                    {
                        over "Metin2___Full_Moon_Sword1_GLTF_SceneRootNode"
                        {
                            over "Metin2___Full_Moon_Sword1__node_001_0"
                            {
                                over "Metin2___Full_Moon_Sword1_Object_4"
                                {
                                    over "Metin2___Full_Moon_Sword1_Object_0"
                                    {
                                        over "Metin2___Full_Moon_Sword1_Object_0" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/blade>
                                        }

                                        over "Metin2___Full_Moon_Sword1_Object_0_1" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/Rings>
                                        }

                                        over "Metin2___Full_Moon_Sword1_Object_0_2" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/Handle_ring>
                                        }

                                        over "Metin2___Full_Moon_Sword1_Object_0_3" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/Handle>
                                        }

                                        over "Metin2___Full_Moon_Sword1_Object_0_4" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/Metin2___Full_Moon_Sword1_pbr_shader>
                                        }

                                        over "Metin2___Full_Moon_Sword1_Object_0_5" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/Safety_top_bottom>
                                        }

                                        over "Metin2___Full_Moon_Sword1_Object_0_6" (
                                            prepend apiSchemas = ["MaterialBindingAPI"]
                                        )
                                        {
                                            rel material:binding = </RootNode/material/Safety_middle>
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

